@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập Admin Panel";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – CineManagement</title>
    
    <!-- Tailwind CSS v4 -->
    <script src="https://unpkg.com/@@tailwindcss/browser@4"></script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>

    <!-- Geist Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body { 
            font-family: 'Geist', sans-serif; 
            background-color: #09090b; /* zinc-950 */
            color: #d4d4d8; /* zinc-300 */
        }
    </style>
</head>
<body class="antialiased min-h-screen flex items-center justify-center p-4 selection:bg-emerald-500/30 selection:text-emerald-200 relative overflow-hidden">
    
    <!-- Ambient Background Effects -->
    <div class="absolute -top-40 -right-40 h-96 w-96 rounded-full bg-emerald-500/10 blur-[120px] pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-emerald-500/15 blur-[120px] pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10">
        <!-- Brand Logo Header -->
        <div class="flex items-center justify-center gap-2 mb-8">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5 group">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 group-hover:scale-105 transition-transform">
                    <i class="ph-bold ph-film-strip text-2xl"></i>
                </div>
                <span class="text-xl font-bold tracking-tight text-zinc-100">CineManagement</span>
            </a>
        </div>

        <!-- Admin Login Card -->
        <div class="rounded-2xl border border-zinc-800/80 bg-zinc-900/80 p-8 md:p-10 shadow-2xl backdrop-blur-2xl relative overflow-hidden">
            <!-- Card Header -->
            <div class="text-center mb-8">
                <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 shadow-inner">
                    <i class="ph-bold ph-shield-checkered text-3xl"></i>
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-zinc-100">Admin Panel</h1>
                <p class="mt-1.5 text-xs font-medium uppercase tracking-widest text-emerald-400/90">Dành riêng cho Quản trị viên & Nhân viên</p>
            </div>

            <!-- Form -->
            <form asp-action="AdminLogin" method="post" class="space-y-5">
                <input type="hidden" asp-for="ReturnUrl" />

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div asp-validation-summary="ModelOnly" class="rounded-xl border border-red-500/30 bg-red-500/10 p-3.5 text-sm text-red-400 flex items-start gap-2.5">
                        <i class="ph-bold ph-warning-circle text-lg shrink-0 mt-0.5"></i>
                        <div>@Html.ValidationSummary(true)</div>
                    </div>
                }

                <!-- Email Input -->
                <div class="space-y-1.5">
                    <label asp-for="Email" class="block text-xs font-semibold uppercase tracking-wider text-zinc-400">Email quản trị</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-zinc-500">
                            <i class="ph ph-envelope-simple text-lg"></i>
                        </div>
                        <input asp-for="Email" 
                               class="w-full rounded-xl border border-zinc-800 bg-zinc-950/80 pl-11 pr-4 py-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-all" 
                               placeholder="admin@cinema.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-xs text-red-400"></span>
                </div>

                <!-- Password Input -->
                <div class="space-y-1.5">
                    <label asp-for="Password" class="block text-xs font-semibold uppercase tracking-wider text-zinc-400">Mật khẩu</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-zinc-500">
                            <i class="ph ph-lock-key text-lg"></i>
                        </div>
                        <input asp-for="Password" type="password"
                               class="w-full rounded-xl border border-zinc-800 bg-zinc-950/80 pl-11 pr-4 py-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-all" 
                               placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-xs text-red-400"></span>
                </div>

                <!-- Remember Me -->
                <div class="flex items-center justify-between pt-1">
                    <label class="flex items-center gap-2.5 cursor-pointer text-sm text-zinc-300 select-none">
                        <input asp-for="RememberMe" 
                               class="h-4 w-4 rounded border-zinc-700 bg-zinc-900 text-emerald-500 focus:ring-emerald-500 focus:ring-offset-zinc-950 accent-emerald-500 transition-all cursor-pointer" />
                        <span>Ghi nhớ phiên đăng nhập</span>
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" 
                        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 py-3.5 text-sm font-semibold text-zinc-950 shadow-lg shadow-emerald-500/20 hover:bg-emerald-400 hover:scale-[0.99] active:scale-[0.97] transition-all">
                    <i class="ph-bold ph-key text-lg"></i>
                    Đăng nhập Hệ thống
                </button>
            </form>

            <!-- Back Link -->
            <div class="mt-8 border-t border-zinc-800/80 pt-6 text-center text-sm text-zinc-400">
                <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-zinc-100 transition-colors group">
                    <i class="ph-bold ph-arrow-left text-zinc-500 group-hover:-translate-x-1 transition-transform"></i>
                    <span>Quay lại trang chủ</span>
                </a>
            </div>
        </div>

        <p class="text-center text-xs text-zinc-600 mt-6">
            &copy; @DateTime.Now.Year CineManagement. Tất cả quyền được bảo lưu.
        </p>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
