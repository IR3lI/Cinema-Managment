@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_Layout";
}

<div class="max-w-xl mx-auto space-y-6">

    <!-- ── Breadcrumb ── -->
    <nav class="flex items-center gap-2 text-xs font-medium text-zinc-400">
        <a asp-controller="Home" asp-action="Index" class="hover:text-zinc-200 transition-colors flex items-center gap-1">
            <i class="ph ph-house text-sm"></i> Trang chủ
        </a>
        <i class="ph ph-caret-right text-zinc-600 text-xs"></i>
        <a asp-action="Profile" class="hover:text-zinc-200 transition-colors">Hồ sơ cá nhân</a>
        <i class="ph ph-caret-right text-zinc-600 text-xs"></i>
        <span class="text-emerald-400 font-semibold">Đổi mật khẩu</span>
    </nav>

    <!-- ── Main Card ── -->
    <div class="relative overflow-hidden rounded-3xl border border-zinc-800/90 bg-zinc-900/70 p-6 sm:p-8 shadow-2xl backdrop-blur-xl">
        <!-- Ambient decorative glows -->
        <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>

        <!-- Header -->
        <div class="text-center mb-8 relative z-10">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-emerald-500/20 bg-emerald-500/10 text-emerald-400 shadow-inner">
                <i class="ph-bold ph-lock-key text-3xl"></i>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-100">Đổi mật khẩu bảo vệ</h1>
            <p class="mt-1.5 text-xs text-zinc-400">Đảm bảo mật khẩu của bạn có độ bảo mật cao và không chia sẻ cho người khác</p>
        </div>

        <form asp-action="ChangePassword" method="post" class="space-y-5 relative z-10">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div asp-validation-summary="ModelOnly" class="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-400 flex items-start gap-2.5">
                    <i class="ph-bold ph-warning-circle text-lg shrink-0 mt-0.5"></i>
                    <div>@Html.ValidationSummary(true)</div>
                </div>
            }

            <!-- Current Password -->
            <div class="space-y-1.5">
                <label asp-for="CurrentPassword" class="block text-xs font-semibold uppercase tracking-wider text-zinc-400">
                    Mật khẩu hiện tại <span class="text-red-400">*</span>
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-zinc-500">
                        <i class="ph ph-shield-check text-base"></i>
                    </div>
                    <input asp-for="CurrentPassword" type="password" id="currentPassInput"
                           class="w-full rounded-xl border border-zinc-800 bg-zinc-950/80 pl-10 pr-11 py-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-all" 
                           placeholder="Nhập mật khẩu đang dùng" />
                    <button type="button" onclick="togglePass('currentPassInput', this)" class="absolute inset-y-0 right-3 flex items-center text-zinc-500 hover:text-zinc-300">
                        <i class="ph ph-eye text-lg"></i>
                    </button>
                </div>
                <span asp-validation-for="CurrentPassword" class="text-xs text-red-400"></span>
            </div>

            <!-- New Password -->
            <div class="space-y-1.5">
                <label asp-for="NewPassword" class="block text-xs font-semibold uppercase tracking-wider text-zinc-400">
                    Mật khẩu mới <span class="text-red-400">*</span>
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-zinc-500">
                        <i class="ph ph-lock-key text-base"></i>
                    </div>
                    <input asp-for="NewPassword" type="password" id="newPassInput"
                           class="w-full rounded-xl border border-zinc-800 bg-zinc-950/80 pl-10 pr-11 py-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-all" 
                           placeholder="Tối thiểu 6 ký tự" />
                    <button type="button" onclick="togglePass('newPassInput', this)" class="absolute inset-y-0 right-3 flex items-center text-zinc-500 hover:text-zinc-300">
                        <i class="ph ph-eye text-lg"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-xs text-red-400"></span>
            </div>

            <!-- Confirm New Password -->
            <div class="space-y-1.5">
                <label asp-for="ConfirmNewPassword" class="block text-xs font-semibold uppercase tracking-wider text-zinc-400">
                    Xác nhận mật khẩu mới <span class="text-red-400">*</span>
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-zinc-500">
                        <i class="ph ph-check-square text-base"></i>
                    </div>
                    <input asp-for="ConfirmNewPassword" type="password" id="confirmPassInput"
                           class="w-full rounded-xl border border-zinc-800 bg-zinc-950/80 pl-10 pr-11 py-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-all" 
                           placeholder="Nhập lại mật khẩu mới" />
                    <button type="button" onclick="togglePass('confirmPassInput', this)" class="absolute inset-y-0 right-3 flex items-center text-zinc-500 hover:text-zinc-300">
                        <i class="ph ph-eye text-lg"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-xs text-red-400"></span>
            </div>

            <!-- Security hint list -->
            <div class="rounded-xl border border-zinc-800/80 bg-zinc-950/40 p-4 text-xs text-zinc-400 space-y-1.5">
                <div class="font-semibold text-zinc-300 mb-1 flex items-center gap-1.5">
                    <i class="ph-bold ph-shield-warning text-emerald-400"></i> Yêu cầu bảo mật:
                </div>
                <div class="flex items-center gap-2 text-zinc-400">
                    <i class="ph-bold ph-check text-emerald-400"></i> Độ dài tối thiểu 6 ký tự
                </div>
                <div class="flex items-center gap-2 text-zinc-400">
                    <i class="ph-bold ph-check text-emerald-400"></i> Bao gồm chữ hoa (A-Z) và chữ thường (a-z)
                </div>
                <div class="flex items-center gap-2 text-zinc-400">
                    <i class="ph-bold ph-check text-emerald-400"></i> Bao gồm chữ số (0-9) và ký tự đặc biệt (@@#$%...)
                </div>
            </div>

            <!-- Action buttons -->
            <div class="pt-4 border-t border-zinc-800/70 flex items-center justify-between gap-3">
                <a asp-action="Profile" 
                   class="px-5 py-2.5 rounded-xl border border-zinc-700 hover:border-zinc-600 text-zinc-300 hover:text-zinc-100 text-sm font-medium transition-colors">
                    Hủy bỏ
                </a>
                <button type="submit" 
                        class="flex-1 sm:flex-none px-6 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-white text-sm font-bold shadow-[0_0_20px_rgba(16,185,129,0.3)] hover:shadow-[0_0_25px_rgba(16,185,129,0.5)] transition-all flex items-center justify-center gap-2 cursor-pointer">
                    <i class="ph-bold ph-check-circle text-base"></i>
                    <span>Cập nhật mật khẩu</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePass(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'ph ph-eye-slash text-lg text-emerald-400';
            } else {
                input.type = 'password';
                icon.className = 'ph ph-eye text-lg text-zinc-500';
            }
        }
    </script>
}
