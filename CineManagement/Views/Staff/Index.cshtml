@model IEnumerable<Staff>
@{
    ViewData["Title"] = "Quản lý Nhân viên";
    Layout = "_AdminLayout";
}

<div class="table-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-people me-2"></i>Danh sách Nhân viên</h5>
        <a asp-action="Create" class="btn btn-warning">
            <i class="bi bi-plus-lg me-1"></i>Thêm nhân viên
        </a>
    </div>

    <!-- Filter -->
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên, email, chức vụ..." />
        </div>
        <div class="col-md-4">
            <select name="department" class="form-select">
                <option value="">– Tất cả phòng ban –</option>
                @foreach (var dept in (IEnumerable<string>)ViewBag.Departments)
                {
                    <option value="@dept" selected="@(dept == ViewBag.Department)">@dept</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search me-1"></i>Tìm kiếm
            </button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Điện thoại</th>
                    <th>Chức vụ</th>
                    <th>Phòng ban</th>
                    <th>Ngày vào làm</th>
                    <th>Trạng thái</th>
                    <th width="130">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.User?.FullName</td>
                        <td class="text-muted small">@s.User?.Email</td>
                        <td>@(s.User?.PhoneNumber ?? "–")</td>
                        <td>@(s.Position ?? "–")</td>
                        <td>@(s.Department ?? "–")</td>
                        <td>@s.HireDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (s.IsActive)
                            { <span class="badge bg-success">Đang làm việc</span> }
                            else
                            { <span class="badge bg-secondary">Đã nghỉ</span> }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@s.StaffId" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@s.StaffId" class="btn btn-sm btn-outline-primary" title="Sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@s.StaffId" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn vô hiệu hóa nhân viên này?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Vô hiệu hóa">
                                    <i class="bi bi-person-x"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-people fs-2"></i>
                <p>Chưa có nhân viên nào.</p>
            </div>
        }
    </div>
</div>
