@model Staff
@{
    ViewData["Title"] = "Chi tiết nhân viên";
    Layout = "_AdminLayout";
}

<div class="table-container">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i></a>
        <h5 class="fw-bold mb-0">Chi tiết nhân viên</h5>
    </div>

    <div class="row g-4">
        <div class="col-md-3 text-center">
            @if (!string.IsNullOrEmpty(Model.User?.AvatarUrl))
            {
                <img src="@Model.User.AvatarUrl" class="rounded-circle shadow" width="120" height="120" style="object-fit:cover;" alt="Avatar" />
            }
            else
            {
                <div class="bg-warning rounded-circle d-inline-flex align-items-center justify-content-center" style="width:120px;height:120px">
                    <i class="bi bi-person-fill fs-1 text-dark"></i>
                </div>
            }
            <h5 class="mt-3 fw-bold">@Model.User?.FullName</h5>
            <p class="text-muted">@(Model.Position ?? "–")</p>
            @if (Model.IsActive)
            { <span class="badge bg-success">Đang làm việc</span> }
            else
            { <span class="badge bg-secondary">Đã nghỉ</span> }
        </div>
        <div class="col-md-9">
            <div class="row g-3">
                <div class="col-md-6">
                    <h6 class="text-muted fw-semibold">Thông tin cá nhân</h6>
                    <table class="table table-borderless table-sm">
                        <tr><th class="text-muted">Email</th><td>@Model.User?.Email</td></tr>
                        <tr><th class="text-muted">Điện thoại</th><td>@(Model.User?.PhoneNumber ?? "–")</td></tr>
                        <tr><th class="text-muted">Ngày sinh</th><td>@(Model.User?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "–")</td></tr>
                        <tr><th class="text-muted">Địa chỉ</th><td>@(Model.User?.Address ?? "–")</td></tr>
                        <tr><th class="text-muted">Tạo lúc</th><td>@Model.User?.CreatedAt.ToString("dd/MM/yyyy")</td></tr>
                    </table>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted fw-semibold">Thông tin công việc</h6>
                    <table class="table table-borderless table-sm">
                        <tr><th class="text-muted">Chức vụ</th><td>@(Model.Position ?? "–")</td></tr>
                        <tr><th class="text-muted">Phòng ban</th><td>@(Model.Department ?? "–")</td></tr>
                        <tr><th class="text-muted">Ngày vào làm</th><td>@Model.HireDate.ToString("dd/MM/yyyy")</td></tr>
                        <tr><th class="text-muted">Lương</th><td>@Model.Salary.ToString("N0") VNĐ</td></tr>
                        <tr><th class="text-muted">Ghi chú</th><td>@(Model.Notes ?? "–")</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.StaffId" class="btn btn-primary me-2">
            <i class="bi bi-pencil me-1"></i>Chỉnh sửa
        </a>
        <form asp-action="Delete" asp-route-id="@Model.StaffId" method="post" class="d-inline"
              onsubmit="return confirm('Vô hiệu hóa nhân viên này?')">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-person-x me-1"></i>Vô hiệu hóa
            </button>
        </form>
    </div>
</div>
