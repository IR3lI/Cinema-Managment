@model ShowtimeFormViewModel
@{
    bool isEdit = Model.ShowtimeId != 0;
    ViewData["Title"] = isEdit ? "Chỉnh sửa lịch chiếu" : "Thêm lịch chiếu";
    Layout = "_AdminLayout";
}

<div class="table-container" style="max-width:650px">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i></a>
        <h5 class="fw-bold mb-0">
            <i class="bi @(isEdit ? "bi-pencil-square text-primary" : "bi-calendar-plus text-warning") me-2"></i>
            @ViewData["Title"]
        </h5>
    </div>

    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.ShowtimeId" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (isEdit) { <input type="hidden" asp-for="ShowtimeId" /> }

        <div class="mb-3">
            <label asp-for="MovieId" class="form-label fw-semibold"></label>
            <select asp-for="MovieId" asp-items="Model.Movies" class="form-select">
                <option value="">– Chọn phim –</option>
            </select>
            <span asp-validation-for="MovieId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RoomId" class="form-label fw-semibold"></label>
            <select asp-for="RoomId" asp-items="Model.Rooms" class="form-select">
                <option value="">– Chọn phòng chiếu –</option>
            </select>
            <span asp-validation-for="RoomId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StartTime" class="form-label fw-semibold"></label>
            <input asp-for="StartTime" type="datetime-local" class="form-control"
                   value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="StartTime" class="text-danger small"></span>
            <div class="form-text">Giờ kết thúc sẽ được tự động tính dựa theo thời lượng phim + 20 phút quảng cáo.</div>
        </div>

        <div class="mb-3">
            <label asp-for="TicketPrice" class="form-label fw-semibold"></label>
            <div class="input-group">
                <input asp-for="TicketPrice" type="number" min="0" step="1000" class="form-control" />
                <span class="input-group-text">VNĐ</span>
            </div>
            <span asp-validation-for="TicketPrice" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label fw-semibold"></label>
            <select asp-for="Status" class="form-select">
                <option value="0">Còn vé</option>
                <option value="1">Hết vé</option>
                <option value="2">Đã hủy</option>
                <option value="3">Đã kết thúc</option>
            </select>
        </div>

        <div class="mb-4">
            <label asp-for="Notes" class="form-label fw-semibold"></label>
            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Ghi chú thêm (tuỳ chọn)"></textarea>
        </div>

        <button type="submit" class="btn btn-warning fw-bold me-2">
            <i class="bi bi-save me-1"></i>@(isEdit ? "Lưu thay đổi" : "Thêm lịch chiếu")
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
