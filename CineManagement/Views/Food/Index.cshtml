@model IEnumerable<FoodItem>
@{
    ViewData["Title"] = "Quản lý Đồ ăn & Nước uống (F&B)";
    Layout = "_AdminLayout";
}

<div class="table-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-cup-straw me-2"></i>Danh mục Đồ ăn & Nước uống</h5>
        <a asp-action="Create" class="btn btn-warning">
            <i class="bi bi-plus-lg me-1"></i>Thêm món mới
        </a>
    </div>

    <!-- Filter -->
    <form method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <select name="category" class="form-select">
                <option value="">– Tất cả danh mục –</option>
                <option value="0" selected="@(ViewBag.Category == FoodCategory.Popcorn)">Bắp rang</option>
                <option value="1" selected="@(ViewBag.Category == FoodCategory.Drink)">Đồ uống</option>
                <option value="2" selected="@(ViewBag.Category == FoodCategory.Combo)">Combo</option>
                <option value="3" selected="@(ViewBag.Category == FoodCategory.Snack)">Snack</option>
                <option value="4" selected="@(ViewBag.Category == FoodCategory.Other)">Khác</option>
            </select>
        </div>
        <div class="col-md-4">
            <select name="available" class="form-select">
                <option value="">– Tất cả trạng thái –</option>
                <option value="true" selected="@(ViewBag.Available == true)">Còn phục vụ</option>
                <option value="false" selected="@(ViewBag.Available == false)">Tạm ngưng</option>
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel me-1"></i>Lọc danh sách
            </button>
        </div>
    </form>

    @if (ViewBag.Category != null || ViewBag.Available != null)
    {
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
            <i class="bi bi-x me-1"></i>Xóa bộ lọc
        </a>
    }

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm border-0 @(!item.IsAvailable ? "opacity-50" : "")">
                    <div style="height:160px; background:#f8f9fa; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            <i class="bi @(item.Category == FoodCategory.Drink ? "bi-cup-straw" : item.Category == FoodCategory.Popcorn ? "bi-basket" : "bi-box2-heart") text-secondary" style="font-size:3.5rem;"></i>
                        }
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="badge @(item.Category == FoodCategory.Combo ? "bg-danger" : item.Category == FoodCategory.Drink ? "bg-info" : "bg-warning text-dark")">
                                @switch (item.Category)
                                {
                                    case FoodCategory.Popcorn: <text>Bắp rang</text> break;
                                    case FoodCategory.Drink:   <text>Đồ uống</text> break;
                                    case FoodCategory.Combo:   <text>Combo</text> break;
                                    case FoodCategory.Snack:   <text>Snack</text> break;
                                    default:                   <text>Khác</text> break;
                                }
                            </span>
                            @if (item.IsAvailable)
                            {
                                <span class="badge bg-success">Còn hàng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Hết hàng</span>
                            }
                        </div>
                        <h6 class="fw-bold mb-1 mt-2 text-truncate" title="@item.Name">@item.Name</h6>
                        <div class="text-success fw-bold fs-6 mb-2">@item.Price.ToString("N0") đ</div>
                        <p class="text-muted small mb-0" style="height:38px; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">
                            @(item.Description ?? "Chưa có mô tả.")
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-0 p-3 pt-0 d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@item.FoodItemId" class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="bi bi-pencil me-1"></i>Sửa
                        </a>
                        <form asp-action="ToggleAvailable" asp-route-id="@item.FoodItemId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm @(item.IsAvailable ? "btn-outline-warning" : "btn-outline-success")" title="@(item.IsAvailable ? "Tạm ngưng" : "Kích hoạt")">
                                <i class="bi @(item.IsAvailable ? "bi-pause-circle" : "bi-play-circle")"></i>
                            </button>
                        </form>
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="Delete" asp-route-id="@item.FoodItemId" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa món này?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-cup-straw fs-1"></i>
                <p class="mt-2">Không tìm thấy món ăn nào.</p>
            </div>
        }
    </div>
</div>
