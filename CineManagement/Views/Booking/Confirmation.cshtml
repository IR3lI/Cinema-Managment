@model ConfirmationViewModel
@{
    ViewData["Title"] = "Đặt vé thành công!";
    Layout = "_Layout";
    var b = Model.Booking;
    var userEmail = b.User?.Email ?? User.Identity?.Name ?? "";
}

@section Styles {
<style>
    @@keyframes pop {
        0%   { transform: scale(0.6); opacity: 0; }
        70%  { transform: scale(1.1); }
        100% { transform: scale(1); opacity: 1; }
    }
    @@media print {
        header, footer, .no-print { display: none !important; }
        body { background: #fff !important; color: #000 !important; }
        .print-card { border: 1px solid #ccc !important; box-shadow: none !important; }
    }
</style>
}

<div class="max-w-3xl mx-auto">

    <!-- Success animation header -->
    <div class="text-center py-8">
        <div class="text-6xl mb-3" style="animation: pop .5s cubic-bezier(.34, 1.56, .64, 1) both">🎉</div>
        <h2 class="text-3xl font-black text-stone-900">Đặt vé thành công!</h2>
        <p class="text-stone-600 mt-2">Cảm ơn bạn đã lựa chọn CineStar. Chúc bạn có trải nghiệm xem phim tuyệt vời!</p>
    </div>

    <!-- Booking code badge card -->
    <div class="rounded-3xl p-8 text-center mb-6 shadow-md border border-emerald-600/30"
         style="background: linear-gradient(135deg, #059669 0%, #047857 100%);">
        <div class="text-emerald-100/80 text-xs font-bold uppercase tracking-widest mb-2">Mã đặt vé (Booking Code)</div>
        <div class="text-4xl md:text-5xl font-black text-white tracking-[.2em] font-mono select-all">@b.BookingCode</div>
        <div class="text-emerald-100/80 text-xs mt-3 flex items-center justify-center gap-1.5 font-medium">
            <i class="ph ph-calendar-check"></i>
            <span>Thời gian đặt: @b.BookingTime.ToVietnameseDateTimeString()</span>
        </div>
    </div>

    <!-- Email Delivery Status & Resend Box (no-print) -->
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/70 p-5 mb-6 shadow-xs no-print">
        <div class="flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center flex-shrink-0 text-xl shadow-xs">
                <i class="ph ph-envelope-simple-check"></i>
            </div>
            <div class="flex-1">
                <div class="font-bold text-emerald-950 text-base">Vé điện tử đã được gửi tới Gmail!</div>
                <p class="text-stone-600 text-xs mt-1 leading-relaxed">
                    Hệ thống đã tự động gửi xác nhận cùng mã vé chi tiết tới: 
                    <span class="font-bold text-emerald-800 bg-emerald-100/80 px-2 py-0.5 rounded">@(string.IsNullOrWhiteSpace(userEmail) ? "hộp thư của bạn" : userEmail)</span>.
                    Vui lòng kiểm tra Hộp thư đến (hoặc thư mục Quảng cáo / Spam).
                </p>

                <!-- Resend Email Button (directly to registered email) -->
                <div class="mt-3.5 pt-3.5 border-t border-emerald-200/80 flex items-center justify-between flex-wrap gap-2">
                    <span class="text-xs text-stone-600 font-medium">Chưa thấy vé trong hộp thư đến hoặc thư rác?</span>
                    <form id="resendEmailForm" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@b.BookingId" />
                        <button type="submit" id="resendEmailBtn"
                                class="px-3.5 py-2 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs transition-colors inline-flex items-center gap-1.5 shadow-2xs cursor-pointer">
                            <i class="ph ph-paper-plane-tilt"></i> Gửi lại vé về Gmail (@userEmail)
                        </button>
                    </form>
                </div>
                <p id="resendStatusMsg" class="mt-2 text-xs font-medium hidden"></p>
            </div>
        </div>
    </div>

    <!-- E-Ticket with Single QR Code for the entire booking -->
    <div class="mb-6">
        <div class="flex items-center justify-between mb-3">
            <h5 class="text-stone-800 text-sm font-bold uppercase tracking-wider flex items-center gap-2">
                <i class="ph ph-qr-code text-emerald-600 text-lg"></i>
                <span>Vé điện tử &amp; Mã QR vào rạp (Gộp @(Model.SeatCodes.Count) vé)</span>
            </h5>
            <button type="button" onclick="window.print()" class="text-xs text-emerald-700 font-bold hover:underline flex items-center gap-1 no-print cursor-pointer">
                <i class="ph ph-printer"></i> In vé
            </button>
        </div>

        <div class="print-card rounded-3xl border-2 border-emerald-500/50 bg-gradient-to-br from-white via-white to-emerald-50/40 p-6 shadow-md relative overflow-hidden">
            <div class="w-3 h-full bg-emerald-600 absolute left-0 top-0"></div>

            <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 pl-2">
                <!-- Single QR Code for all seats -->
                <div class="flex-shrink-0 flex flex-col items-center bg-white p-3 rounded-2xl border-2 border-emerald-200 shadow-sm">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@Uri.EscapeDataString(b.BookingCode)"
                         alt="QR @b.BookingCode"
                         class="w-36 h-36 sm:w-40 sm:h-40 object-contain" />
                    <span class="mt-2 text-[11px] font-mono font-black text-emerald-800 tracking-wider">@b.BookingCode</span>
                    <span class="text-[10px] text-stone-500 font-medium">1 mã QR cho tất cả ghế</span>
                </div>

                <!-- Ticket Info -->
                <div class="flex-1 min-w-0 text-center sm:text-left">
                    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-2">
                        <span class="px-3.5 py-1 rounded-full bg-emerald-600 text-white font-black text-sm shadow-xs">
                            Ghế: @string.Join(", ", Model.SeatCodes)
                        </span>
                        <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs">
                            @Model.SeatCodes.Count vé
                        </span>
                        <span class="px-2 py-0.5 rounded-md bg-stone-100 text-stone-600 font-semibold text-[11px]">
                            Vé điện tử hợp lệ
                        </span>
                    </div>

                    <h4 class="text-xl font-black text-stone-900 mt-2">@b.Showtime?.Movie?.Title</h4>

                    <div class="mt-3 space-y-1.5 text-xs text-stone-600">
                        <div class="flex items-center justify-center sm:justify-start gap-2">
                            <i class="ph ph-clock text-emerald-600 text-sm"></i>
                            <span class="font-bold text-stone-800">@b.Showtime?.StartTime.ToVietnameseDateTimeString()</span>
                        </div>
                        <div class="flex items-center justify-center sm:justify-start gap-2">
                            <i class="ph ph-film-slate text-emerald-600 text-sm"></i>
                            <span class="font-medium text-stone-700">Phòng chiếu: @b.Showtime?.Room?.RoomName</span>
                        </div>
                        <div class="flex items-center justify-center sm:justify-start gap-2">
                            <i class="ph ph-currency-circle-dollar text-emerald-600 text-sm"></i>
                            <span class="font-medium text-stone-700">Tổng tiền vé: <strong class="text-emerald-700">@b.FinalAmount.ToString("N0") đ</strong></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-emerald-100/80 text-xs text-emerald-800 flex items-center justify-center sm:justify-start gap-2 bg-emerald-50/60 p-2.5 rounded-xl">
                        <i class="ph ph-info text-base text-emerald-600 flex-shrink-0"></i>
                        <span>Xuất trình mã QR duy nhất này tại cửa soát vé để nhân viên check-in toàn bộ <strong>@Model.SeatCodes.Count ghế</strong> cùng lúc.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Booking Details card -->
    <div class="print-card rounded-2xl border border-[#E7E2D9] bg-white shadow-sm overflow-hidden mb-6">

        <!-- Movie Header -->
        <div class="p-5 border-b border-stone-200 flex items-start gap-4 bg-stone-50/40">
            @if (!string.IsNullOrEmpty(b.Showtime?.Movie?.PosterUrl))
            {
                <img src="@b.Showtime.Movie.PosterUrl" alt="Poster"
                     class="w-16 h-24 object-cover rounded-xl flex-shrink-0 shadow-sm border border-stone-200" />
            }
            <div>
                <div class="text-xl font-bold text-stone-900">@b.Showtime?.Movie?.Title</div>
                <div class="text-stone-600 text-sm mt-1.5 space-y-1">
                    <div class="flex items-center gap-1.5">
                        <i class="ph ph-clock text-emerald-600"></i>
                        <span>@b.Showtime?.StartTime.ToVietnameseDateTimeString()</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <i class="ph ph-film-slate text-emerald-600"></i>
                        <span>@b.Showtime?.Room?.RoomName</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seats -->
        <div class="p-5 border-b border-stone-200">
            <div class="text-stone-500 text-xs font-bold uppercase tracking-wider mb-2.5">Danh sách ghế</div>
            <div class="flex flex-wrap gap-2">
                @foreach (var code in Model.SeatCodes)
                {
                    <span class="px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-bold shadow-2xs">
                        @code
                    </span>
                }
            </div>
        </div>

        <!-- F&B -->
        @if (b.BookingConcessions?.Any() == true)
        {
            <div class="p-5 border-b border-stone-200">
                <div class="text-stone-500 text-xs font-bold uppercase tracking-wider mb-2.5">Đồ ăn & Nước uống</div>
                <div class="space-y-2">
                    @foreach (var bf in b.BookingConcessions)
                    {
                        <div class="flex justify-between items-center text-sm py-1">
                            <div class="flex items-center gap-2.5 min-w-0">
                                @if (!string.IsNullOrEmpty(bf.FoodItem?.ImageUrl))
                                {
                                    <img src="@bf.FoodItem.ImageUrl" alt="@bf.FoodItem.Name"
                                         class="w-8 h-8 rounded-lg object-cover border border-stone-200 flex-shrink-0" />
                                }
                                <span class="text-stone-700 font-medium">@bf.FoodItem?.Name <span class="text-stone-400 font-normal">×@bf.Quantity</span></span>
                            </div>
                            <span class="text-stone-900 font-semibold whitespace-nowrap ml-2">@((bf.UnitPrice * bf.Quantity).ToString("N0")) đ</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Payment summary -->
        <div class="p-5 bg-stone-50/20">
            <div class="space-y-2.5 text-sm">
                @if (b.Voucher != null)
                {
                    <div class="flex justify-between text-emerald-700 font-medium">
                        <span>Mã giảm giá (@b.Voucher.Code)</span>
                        <span>–@b.DiscountAmount.ToString("N0") đ</span>
                    </div>
                }
                <div class="flex justify-between items-center pt-2.5 border-t border-stone-200">
                    <span class="font-bold text-stone-900 text-base">Tổng tiền đã thanh toán</span>
                    <span class="text-2xl font-black text-emerald-700">@b.FinalAmount.ToString("N0") đ</span>
                </div>
                <div class="flex justify-between text-stone-500 text-xs">
                    <span>Hình thức thanh toán:</span>
                    <span class="font-medium text-stone-800">
                        @switch (b.PaymentMethod)
                        {
                            case PaymentMethod.BankCard: <text>💳 Thẻ ngân hàng</text> break;
                            case PaymentMethod.EWallet:  <text>📱 Thanh toán bằng ví điện tử</text> break;
                            default:                     <text>💵 Tiền mặt tại quầy</text> break;
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions (no-print) -->
    <div class="flex flex-wrap gap-3 justify-center mt-6 pb-12 no-print">
        <button type="button" onclick="window.print()"
                class="px-6 py-3 rounded-xl border border-stone-300 hover:bg-stone-50 text-stone-700 text-sm font-semibold transition-colors flex items-center gap-2 shadow-xs cursor-pointer">
            <i class="ph ph-printer text-lg"></i> In vé / Tải PDF
        </button>
        <a asp-action="MyBookings"
           class="px-6 py-3 rounded-xl border border-stone-300 hover:bg-stone-50 text-stone-700 text-sm font-semibold transition-colors flex items-center gap-2 shadow-xs">
            <i class="ph ph-ticket text-lg"></i> Lịch sử đặt vé
        </a>
        <a asp-controller="Home" asp-action="Index"
           class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold transition-all flex items-center gap-2 shadow-md hover:shadow-lg">
            <i class="ph ph-film-strip text-lg"></i> Khám phá phim khác
        </a>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('resendEmailForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('resendEmailBtn');
        const msg = document.getElementById('resendStatusMsg');

        btn.disabled = true;
        btn.innerHTML = '<i class="ph ph-spinner animate-spin"></i> Đang gửi...';
        msg.classList.remove('hidden');
        msg.className = 'mt-2 text-xs font-medium text-stone-500';
        msg.textContent = 'Đang kết nối tới máy chủ Gmail và gửi lại vé...';

        try {
            const formData = new FormData();
            formData.append('bookingId', '@b.BookingId');
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

            const res = await fetch('/Booking/ResendEmail', {
                method: 'POST',
                body: new URLSearchParams(formData)
            });
            const data = await res.json();

            if (data.success) {
                msg.className = 'mt-2 text-xs font-bold text-emerald-700';
                msg.textContent = '✓ ' + data.message;
            } else {
                msg.className = 'mt-2 text-xs font-bold text-rose-600';
                msg.textContent = '✗ ' + data.message;
            }
        } catch (err) {
            msg.className = 'mt-2 text-xs font-bold text-rose-600';
            msg.textContent = '✗ Lỗi kết nối khi gửi email.';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="ph ph-paper-plane-tilt"></i> Gửi lại vé về Gmail (@userEmail)';
        }
    });
</script>
}
