@model CineManagement.ViewModels.SelectSeatViewModel
@{
    ViewData["Title"] = "Chọn ghế – " + Model.Showtime.Movie?.Title;
    Layout = "_Layout";
    var holdUntil = ViewBag.HoldUntil as DateTime?;
    long holdUntilMs = holdUntil.HasValue
        ? (long)(holdUntil.Value.ToUniversalTime() - DateTime.UnixEpoch).TotalMilliseconds : 0;

    string RoomTypeBadge(RoomType t) => t switch {
        RoomType.VIP  => "bg-amber-500/20 text-amber-300 border-amber-500/30",
        RoomType.IMAX => "bg-purple-500/20 text-purple-300 border-purple-500/30",
        _             => "bg-stone-500/20 text-stone-300 border-stone-500/30"
    };
    string RoomTypeLabel(RoomType t) => t switch {
        RoomType.VIP  => "Phòng VIP",
        RoomType.IMAX => "Phòng IMAX",
        _             => "Tiêu chuẩn"
    };
}

<div data-holduntil="@holdUntilMs" id="holduntilData" style="display:none"></div>

@section Styles {
<style>
/* ── Cinema Dark Mode ────────────────────────────────────────── */
.cinema-board {
    background: radial-gradient(circle at 50% 0%, #1e293b 0%, #0f172a 60%, #090d16 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
}

/* ── Screen Arc & Illumination ───────────────────────────────── */
.screen-arc {
    height: 12px;
    background: linear-gradient(180deg, rgba(52, 211, 153, 0.8) 0%, rgba(16, 185, 129, 0.05) 100%);
    border-radius: 50% 50% 0 0;
    width: 72%;
    margin: 0 auto;
    filter: drop-shadow(0 0 16px rgba(16, 185, 129, 0.45));
}
.screen-glow {
    position: relative;
}
.screen-glow::after {
    content: '';
    position: absolute;
    top: -20px;
    left: 20%;
    right: 20%;
    height: 40px;
    background: radial-gradient(ellipse at center, rgba(16, 185, 129, 0.25) 0%, transparent 70%);
    pointer-events: none;
}

/* ── 2D CSS Grid Matrix ──────────────────────────────────────── */
.cinema-grid-container {
    display: grid;
    grid-template-rows: repeat(@Model.TotalRows, 38px);
    grid-template-columns: repeat(@Model.TotalCols, 38px);
    gap: 7px;
    justify-content: center;
    margin: 0 auto;
    padding: 10px;
    min-width: 750px;
}

/* ── Seat Button Base ────────────────────────────────────────── */
.seat-btn {
    border-radius: 7px 7px 3px 3px;
    border: 1.5px solid;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: 0.62rem;
    font-weight: 800;
    user-select: none;
    cursor: pointer;
    transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    outline: none;
}
.seat-btn::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 2px;
    right: 2px;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: inherit;
    filter: brightness(0.7);
}

/* ── Seat States ─────────────────────────────────────────────── */
.seat-standard {
    background: #1e293b;
    border-color: #475569;
    color: #e2e8f0;
}
.seat-vip {
    background: #3b2a1a;
    border-color: #d97706;
    color: #fef3c7;
}
.seat-couple {
    background: #2e1a47;
    border-color: #9333ea;
    color: #f3e8ff;
}

.seat-btn.seat-available:hover {
    transform: translateY(-3px) scale(1.06);
    filter: brightness(1.25);
    border-color: #10b981;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    z-index: 5;
}

.seat-selected {
    background: #059669 !important;
    border-color: #34d399 !important;
    color: #ffffff !important;
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 0 16px rgba(16, 185, 129, 0.6) !important;
    z-index: 10;
}

.seat-held-me {
    background: #064e3b !important;
    border-color: #10b981 !important;
    color: #a7f3d0 !important;
}
.seat-held-other {
    background: #334155 !important;
    border-color: #475569 !important;
    color: #94a3b8 !important;
    cursor: not-allowed !important;
    opacity: 0.65;
}
.seat-booked {
    background: #0f172a !important;
    border-color: #1e293b !important;
    color: #475569 !important;
    cursor: not-allowed !important;
    opacity: 0.45;
}

/* ── Ticket Summary Card ─────────────────────────────────────── */
.ticket-summary-card {
    background: #111827;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    position: sticky;
    top: 90px;
}

@@keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
    50%       { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
}
.btn-hold-active {
    animation: pulse-glow 2s infinite;
}
</style>
}

<!-- Step Progress Bar -->
<div class="flex items-center gap-2 mb-8 text-sm">
    <span class="flex items-center gap-2 text-emerald-400 font-bold">
        <span class="w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs">1</span>
        Chọn ghế
    </span>
    <div class="flex-1 h-px bg-stone-700"></div>
    <span class="flex items-center gap-2 text-stone-500 font-medium">
        <span class="w-6 h-6 rounded-full bg-stone-800 text-stone-400 flex items-center justify-center text-xs">2</span>
        Bắp nước (F&B)
    </span>
    <div class="flex-1 h-px bg-stone-700"></div>
    <span class="flex items-center gap-2 text-stone-500 font-medium">
        <span class="w-6 h-6 rounded-full bg-stone-800 text-stone-400 flex items-center justify-center text-xs">3</span>
        Thanh toán
    </span>
</div>

<div class="flex flex-col lg:flex-row gap-6 items-start">

    <!-- ═══ LEFT: 2D Matrix Grid Sơ đồ ghế ═════════════════════════ -->
    <div class="flex-1 w-full min-w-0">
        <div class="cinema-board rounded-3xl overflow-hidden">

            <!-- Card Header -->
            <div class="px-6 py-4 border-b border-white/5 bg-slate-900/60 flex items-center justify-between flex-wrap gap-3">
                <div>
                    <div class="font-bold text-white flex items-center gap-2 text-base">
                        <i class="ph ph-film-slate text-emerald-400 text-lg"></i>
                        <span>Sơ đồ phòng chiếu: @Model.Room.RoomName</span>
                        <span class="text-xs px-2.5 py-0.5 rounded-full border @RoomTypeBadge(Model.Room.RoomType)">@RoomTypeLabel(Model.Room.RoomType)</span>
                    </div>
                    <div class="text-stone-400 text-xs mt-1">
                        🎬 @Model.Showtime.Movie?.Title · ⏰ @Model.Showtime.StartTime.ToVietnameseDateTimeString()
                    </div>
                </div>
                @if (holdUntil.HasValue)
                {
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-amber-500/10 border border-amber-500/30">
                        <i class="ph ph-hourglass-medium text-amber-400 text-sm"></i>
                        <span class="text-xs text-amber-300 font-medium">Giữ chỗ:</span>
                        <span id="countdown" class="text-amber-400 font-bold text-sm tabular-nums">--:--</span>
                    </div>
                }
            </div>

            <!-- Screen Area -->
            <div class="pt-8 pb-4 text-center screen-glow">
                <div class="screen-arc"></div>
                <div class="text-emerald-400 text-[11px] tracking-[0.3em] font-extrabold uppercase mt-2 opacity-80">
                    MÀN HÌNH CHIẾU (SCREEN)
                </div>
            </div>

            <!-- 2D CSS Grid Layout -->
            <div class="overflow-x-auto px-4 pb-8 pt-2">
                <div class="cinema-grid-container" style="display: grid; grid-template-rows: repeat(@Model.TotalRows, 38px); grid-template-columns: repeat(@Model.TotalCols, 38px); gap: 7px; justify-content: center;">
                    @foreach (var seat in Model.Seats)
                    {
                        string typeCss = seat.SeatType switch {
                            SeatTypeEnum.VIP    => "seat-vip",
                            SeatTypeEnum.Couple => "seat-couple",
                            _                   => "seat-standard"
                        };

                        string statusCss = seat.Status switch {
                            SelectSeatViewModel.SeatStatus.HeldByMe    => "seat-held-me",
                            SelectSeatViewModel.SeatStatus.HeldByOther => "seat-held-other",
                            SelectSeatViewModel.SeatStatus.Booked      => "seat-booked",
                            _                                           => "seat-available"
                        };

                        bool clickable = seat.Status == SelectSeatViewModel.SeatStatus.Available;

                        <button type="button"
                                class="seat-btn @typeCss @statusCss"
                                style="grid-row-start: @seat.GridRow; grid-column-start: @seat.GridCol; grid-column-end: span @seat.ColSpan;"
                                data-seat-id="@seat.SeatId"
                                data-seat-code="@seat.SeatCode"
                                data-grid-row="@seat.GridRow"
                                data-grid-col="@seat.GridCol"
                                data-colspan="@seat.ColSpan"
                                data-price="@seat.Price"
                                data-type-name="@seat.SeatTypeName"
                                data-clickable="@clickable.ToString().ToLower()"
                                title="@seat.SeatCode (@seat.SeatTypeName) — @seat.Price.ToString("N0") đ">
                            <span>@seat.SeatCode</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Dynamic Legend (Đọc động từ SeatTypes DTO) -->
            <div class="border-t border-white/5 px-6 py-4 bg-slate-950/40 flex flex-wrap gap-4 justify-center items-center text-xs">
                @foreach (var st in Model.SeatTypes)
                {
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-5 rounded border flex items-center justify-center font-bold text-[9px]"
                             style="background: @st.ColorCode; border-color: @st.ColorCode; color: #fff;">
                            @(st.Code == "COUPLE" ? "Đôi" : (st.Code == "VIP" ? "VIP" : "Th"))
                        </div>
                        <span class="text-stone-300 font-medium">
                            @st.Name
                            @if (st.Surcharge > 0)
                            {
                                <span class="text-emerald-400 font-bold">(+@st.Surcharge.ToString("N0")đ)</span>
                            }
                        </span>
                    </div>
                }
                <div class="flex items-center gap-2">
                    <div class="w-6 h-5 rounded bg-emerald-600 border border-emerald-400 text-white flex items-center justify-center font-bold text-[9px] shadow-sm">✓</div>
                    <span class="text-stone-300 font-medium">Đang chọn</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-6 h-5 rounded bg-slate-700 border border-slate-600 text-stone-400 flex items-center justify-center font-bold text-[9px]">✕</div>
                    <span class="text-stone-400 font-medium">Đang giữ</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-6 h-5 rounded bg-slate-900 border border-slate-800 text-stone-600 flex items-center justify-center font-bold text-[9px]">✕</div>
                    <span class="text-stone-500 font-medium">Đã bán</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ RIGHT: Ticket Detail Card ════════════════════════════════ -->
    <div class="w-full lg:w-80 flex-shrink-0">
        <div class="ticket-summary-card overflow-hidden">

            <!-- Movie Poster Header -->
            <div class="relative bg-slate-900 h-36">
                @if (!string.IsNullOrEmpty(Model.Showtime.Movie?.PosterUrl))
                {
                    <img src="@Model.Showtime.Movie.PosterUrl" alt="Poster"
                         class="w-full h-full object-cover opacity-60" />
                }
                <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 to-transparent"></div>
                <div class="absolute bottom-3 left-4 right-4">
                    <h4 class="text-white font-bold text-sm line-clamp-1">@Model.Showtime.Movie?.Title</h4>
                    <div class="text-stone-300 text-xs mt-0.5 font-medium">
                        @Model.Room.RoomName · @Model.Showtime.Format
                    </div>
                </div>
            </div>

            <!-- Order Details -->
            <div class="p-5 space-y-4">
                <div class="text-xs text-stone-400 space-y-1.5 pb-3 border-b border-white/10">
                    <div class="flex justify-between">
                        <span>Suất chiếu:</span>
                        <span class="text-white font-semibold">@Model.Showtime.StartTime.ToString("HH:mm - dd/MM/yyyy")</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Giá vé cơ sở:</span>
                        <span class="text-stone-300 font-medium">@Model.Showtime.TicketPrice.ToString("N0") đ</span>
                    </div>
                </div>

                <!-- Selected Seats List -->
                <div>
                    <div class="text-xs font-bold text-stone-300 uppercase tracking-wider mb-2 flex justify-between items-center">
                        <span>Ghế đã chọn:</span>
                        <span id="selectedCount" class="text-emerald-400 font-extrabold text-sm">0</span>
                    </div>
                    <div id="selectedSeatsBadges" class="flex flex-wrap gap-1.5 min-h-[40px] items-center">
                        <span class="text-stone-500 text-xs italic">Vui lòng nhấp ghế trên sơ đồ...</span>
                    </div>
                </div>

                <!-- Total Amount -->
                <div class="pt-3 border-t border-white/10">
                    <div class="flex justify-between items-baseline">
                        <span class="text-stone-300 text-sm font-semibold">Tổng tiền vé:</span>
                        <span id="totalPrice" class="text-emerald-400 font-black text-xl">0 đ</span>
                    </div>
                </div>

                <!-- Orphan seat warning alert -->
                <div id="orphanAlert" class="hidden p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs leading-relaxed">
                    <i class="ph ph-warning-circle text-sm text-rose-400 mr-1 align-text-bottom"></i>
                    <span id="orphanAlertText">Không được để trống 1 ghế lẻ loi. Vui lòng chọn ghế liền kề nhau.</span>
                </div>

                <!-- Action Button Form -->
                <form asp-action="HoldSeats" method="post" id="holdSeatsForm">
                    <input type="hidden" name="showtimeId" value="@Model.Showtime.ShowtimeId" />
                    <div id="hiddenSeatInputs"></div>
                    <button type="submit" id="btnContinue" disabled
                            class="w-full py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 disabled:bg-stone-800 disabled:text-stone-500 text-white font-bold text-sm transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg disabled:cursor-not-allowed">
                        <i class="ph ph-lock-key-open"></i>
                        <span id="btnContinueText">Chọn ghế để tiếp tục</span>
                    </button>
                </form>

                <a asp-action="MovieDetail" asp-controller="Home" asp-route-id="@Model.Showtime.MovieId"
                   class="w-full py-2 rounded-xl border border-white/10 hover:bg-white/5 text-stone-400 hover:text-white text-xs font-semibold transition-colors flex items-center justify-center gap-1.5 text-center">
                    <i class="ph ph-arrow-left"></i> Quay lại chi tiết phim
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/signalr/signalr.min.js"></script>
<script>
    const showtimeId = @Model.Showtime.ShowtimeId;
    const ticketPrice = @Model.Showtime.TicketPrice;
    const selectedSeats = new Map(); // seatId -> { id, code, price, type, gridRow, gridCol, colSpan }

    // ── SignalR Real-time Connection ─────────────────────────────────
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/seatBooking")
        .withAutomaticReconnect([0, 2000, 5000, 10000])
        .build();

    connection.on("SeatStatusChanged", function (data) {
        if (data.showtimeId !== showtimeId) return;

        const btn = document.querySelector(`.seat-btn[data-seat-id='${data.seatId}']`);
        if (!btn) return;

        console.log(`[Realtime SignalR] Seat ${data.seatCode} status changed to ${data.status}`);

        if (data.status === 2) { // Reserved (Đã bán)
            if (selectedSeats.has(data.seatId)) {
                selectedSeats.delete(data.seatId);
                btn.classList.remove('seat-selected');
                updateSummaryUI();
                showToast(`Ghế ${data.seatCode} bạn đang chọn vừa được thanh toán thành công bởi khách khác!`);
            }
            btn.classList.remove('seat-available', 'seat-held', 'seat-selected');
            btn.classList.add('seat-sold');
            btn.dataset.clickable = 'false';
            btn.setAttribute('title', `Ghế ${data.seatCode} - Đã bán`);
        } else if (data.status === 1) { // Held (Đang giữ)
            if (!selectedSeats.has(data.seatId)) {
                btn.classList.remove('seat-available');
                btn.classList.add('seat-held');
                btn.dataset.clickable = 'false';
                btn.setAttribute('title', `Ghế ${data.seatCode} - Đang được người khác giữ chỗ`);
                showToast(`Ghế ${data.seatCode} vừa có người giữ chỗ.`);
            }
        } else if (data.status === 0) { // Available (Trống trở lại)
            if (!selectedSeats.has(data.seatId)) {
                btn.classList.remove('seat-held', 'seat-sold');
                btn.classList.add('seat-available');
                btn.dataset.clickable = 'true';
                btn.setAttribute('title', `Ghế ${data.seatCode} - Còn trống`);
            }
        }
    });

    connection.start().then(() => {
        console.log("[SignalR] Kết nối thành công tới SeatBookingHub cho Suất chiếu #" + showtimeId);
        connection.invoke("JoinShowtimeGroup", showtimeId);
    }).catch(err => console.error("[SignalR] Lỗi kết nối:", err));

    function showToast(msg) {
        const toast = document.createElement('div');
        toast.className = 'fixed bottom-6 right-6 z-50 px-4 py-2.5 rounded-xl bg-stone-900 border border-stone-700 text-stone-200 text-xs font-semibold shadow-2xl flex items-center gap-2 animate-in fade-in slide-in-from-bottom-3 duration-300';
        toast.innerHTML = `<i class="ph ph-bell-ringing text-amber-400 text-base"></i><span>${msg}</span>`;
        document.body.appendChild(toast);
        setTimeout(() => {
            toast.classList.add('opacity-0', 'transition-opacity', 'duration-500');
            setTimeout(() => toast.remove(), 500);
        }, 4000);
    }

    // Click chọn ghế
    document.querySelectorAll('.seat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            if (btn.dataset.clickable !== 'true') return;
            const id = parseInt(btn.dataset.seatId);
            const code = btn.dataset.seatCode;
            const price = parseFloat(btn.dataset.price);
            const type = btn.dataset.typeName;
            const gridRow = parseInt(btn.dataset.gridRow);
            const gridCol = parseInt(btn.dataset.gridCol);
            const colSpan = parseInt(btn.dataset.colspan);

            if (selectedSeats.has(id)) {
                selectedSeats.delete(id);
                btn.classList.remove('seat-selected');
            } else {
                if (selectedSeats.size >= 10) {
                    alert('Bạn chỉ có thể chọn tối đa 10 ghế trong một đơn đặt!');
                    return;
                }
                selectedSeats.set(id, { id, code, price, type, gridRow, gridCol, colSpan });
                btn.classList.add('seat-selected');
            }

            updateSummaryUI();
        });
    });

    function updateSummaryUI() {
        const count = selectedSeats.size;
        const countEl = document.getElementById('selectedCount');
        const totalEl = document.getElementById('totalPrice');
        const badgesEl = document.getElementById('selectedSeatsBadges');
        const hiddenInputsEl = document.getElementById('hiddenSeatInputs');
        const btnContinue = document.getElementById('btnContinue');
        const btnText = document.getElementById('btnContinueText');
        const orphanAlert = document.getElementById('orphanAlert');

        orphanAlert.classList.add('hidden');
        countEl.textContent = count;

        let total = 0;
        badgesEl.innerHTML = '';
        hiddenInputsEl.innerHTML = '';

        if (count === 0) {
            badgesEl.innerHTML = '<span class="text-stone-500 text-xs italic">Vui lòng nhấp ghế trên sơ đồ...</span>';
            totalEl.textContent = '0 đ';
            btnContinue.disabled = true;
            btnContinue.classList.remove('btn-hold-active');
            btnText.textContent = 'Chọn ghế để tiếp tục';
            return;
        }

        selectedSeats.forEach(s => {
            total += s.price;

            // Render badge
            const badge = document.createElement('span');
            badge.className = 'px-2 py-0.5 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 font-bold text-xs flex items-center gap-1';
            badge.innerHTML = `${s.code} <small class="opacity-75">(${s.type})</small>`;
            badgesEl.appendChild(badge);

            // Hidden input
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'selectedSeatIds';
            input.value = s.id;
            hiddenInputsEl.appendChild(input);
        });

        totalEl.textContent = total.toLocaleString('vi-VN') + ' đ';
        btnContinue.disabled = false;
        btnContinue.classList.add('btn-hold-active');
        btnText.textContent = `Giữ ${count} ghế & Chọn Bắp nước`;
    }

    // ── Orphan Seat Validation (Không để trống 1 ghế đơn độc) ─────────
    document.getElementById('holdSeatsForm').addEventListener('submit', function (e) {
        const orphanIssue = checkOrphanSeat();
        if (orphanIssue) {
            e.preventDefault();
            const orphanAlert = document.getElementById('orphanAlert');
            const alertText = document.getElementById('orphanAlertText');
            alertText.textContent = orphanIssue;
            orphanAlert.classList.remove('hidden');
            orphanAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });

    function checkOrphanSeat() {
        if (selectedSeats.size === 0) return null;

        // Tập hợp tất cả các ghế theo hàng
        const allSeatButtons = Array.from(document.querySelectorAll('.seat-btn'));
        const seatsByRow = new Map();

        allSeatButtons.forEach(btn => {
            const row = parseInt(btn.dataset.gridRow);
            const col = parseInt(btn.dataset.gridCol);
            const id = parseInt(btn.dataset.seatId);
            const code = btn.dataset.seatCode;
            const isClickable = btn.dataset.clickable === 'true';
            const isSelected = selectedSeats.has(id);
            const isSoldOrHeld = !isClickable && !isSelected;

            if (!seatsByRow.has(row)) seatsByRow.set(row, []);
            seatsByRow.get(row).push({ id, code, row, col, isSelected, isSoldOrHeld });
        });

        // Kiểm tra trên từng hàng (phân tách theo hành lang cột 4 và 13)
        for (const [row, seats] of seatsByRow.entries()) {
            seats.sort((a, b) => a.col - b.col);

            // Tách các cụm ghế ngăn cách bởi khoảng trống hành lang (gap > 1)
            const clusters = [];
            let currentCluster = [];

            for (let i = 0; i < seats.length; i++) {
                if (currentCluster.length === 0) {
                    currentCluster.push(seats[i]);
                } else {
                    const prev = currentCluster[currentCluster.length - 1];
                    if (seats[i].col === prev.col + 1) {
                        currentCluster.push(seats[i]);
                    } else {
                        clusters.push(currentCluster);
                        currentCluster = [seats[i]];
                    }
                }
            }
            if (currentCluster.length > 0) clusters.push(currentCluster);

            // Kiểm tra trong từng cụm
            for (const cluster of clusters) {
                const hasSelectedInCluster = cluster.some(s => s.isSelected);
                if (!hasSelectedInCluster) continue;

                const n = cluster.length;
                for (let i = 0; i < n; i++) {
                    const current = cluster[i];
                    // Nếu ghế này còn trống (chưa bán, không được chọn)
                    if (!current.isSelected && !current.isSoldOrHeld) {
                        const leftTaken = (i === 0) || (cluster[i - 1].isSelected || cluster[i - 1].isSoldOrHeld);
                        const rightTaken = (i === n - 1) || (cluster[i + 1].isSelected || cluster[i + 1].isSoldOrHeld);

                        // Ghế lẻ loi đơn độc: Cả 2 bên đều bị chiếm / giáp tường
                        if (leftTaken && rightTaken) {
                            return `Bạn đang để trống 1 ghế lẻ (${current.code})! Vui lòng chọn ghế liền kề nhau để tối ưu chỗ ngồi.`;
                        }
                    }
                }
            }
        }
        return null;
    }

    // ── Countdown Timer ──────────────────────────────────────────────
    const holdUntilData = document.getElementById('holduntilData');
    const holdUntilMs = parseInt(holdUntilData.dataset.holduntil || '0');
    const countdownEl = document.getElementById('countdown');

    if (holdUntilMs > 0 && countdownEl) {
        function tick() {
            const diff = holdUntilMs - Date.now();
            if (diff <= 0) {
                countdownEl.textContent = '00:00';
                alert('Thời gian giữ chỗ của bạn đã hết. Vui lòng tải lại trang để chọn lại ghế!');
                location.reload();
                return;
            }
            const mins = Math.floor(diff / 60000);
            const secs = Math.floor((diff % 60000) / 1000);
            countdownEl.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }
        tick();
        setInterval(tick, 1000);
    }
</script>
}
