@model IEnumerable<Booking>
@{
    ViewData["Title"] = "Lịch sử đặt vé";
    Layout = "_Layout";
    var bookings = Model?.ToList() ?? new List<Booking>();
}

<div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-4 border-b border-[#E7E2D9]">
        <div>
            <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl shadow-2xs">
                    <i class="ph ph-ticket"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-black text-stone-900 tracking-tight">Lịch sử đặt vé của tôi</h1>
                    <p class="text-stone-500 text-xs mt-0.5">Quản lý toàn bộ vé đã đặt, xem mã vào rạp và hóa đơn</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <span class="px-3.5 py-1.5 rounded-full bg-stone-100 border border-stone-200 text-stone-700 text-xs font-bold shadow-2xs">
                Tổng cộng: <strong class="text-emerald-700">@bookings.Count</strong> đơn
            </span>
            <a asp-controller="Home" asp-action="Index"
               class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all flex items-center gap-1.5 shadow-xs">
                <i class="ph ph-plus-circle"></i> Đặt vé mới
            </a>
        </div>
    </div>

    @if (!bookings.Any())
    {
        <!-- Empty State -->
        <div class="py-16 text-center rounded-3xl border border-dashed border-[#E7E2D9] bg-white p-8 shadow-xs max-w-xl mx-auto">
            <div class="w-20 h-20 mx-auto mb-4 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-4xl shadow-inner">
                <i class="ph ph-ticket-perforated"></i>
            </div>
            <h3 class="text-lg font-bold text-stone-800 mb-1">Bạn chưa có vé xem phim nào</h3>
            <p class="text-sm text-stone-500 max-w-md mx-auto mb-6">
                Các bộ phim bom tấn đỉnh cao đang chờ đón bạn. Hãy chọn phim và ghế ngồi yêu thích ngay hôm nay!
            </p>
            <a asp-controller="Home" asp-action="Index"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md transition-all">
                <i class="ph ph-film-strip"></i> Khám phá phim đang chiếu
            </a>
        </div>
    }
    else
    {
        <!-- Booking Tickets Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var b in bookings)
            {
                var (statusBg, statusText, statusIcon) = b.Status switch {
                    BookingStatus.Confirmed => ("bg-emerald-100 text-emerald-800 border-emerald-200", "Đã xác nhận", "ph-check-circle"),
                    BookingStatus.Pending   => ("bg-amber-100 text-amber-800 border-amber-200", "Chờ thanh toán", "ph-clock-countdown"),
                    BookingStatus.Cancelled => ("bg-stone-200 text-stone-700 border-stone-300", "Đã hủy", "ph-x-circle"),
                    _                       => ("bg-rose-100 text-rose-800 border-rose-200", "Hết hạn", "ph-warning-circle")
                };

                var seats = b.Tickets.Select(t => !string.IsNullOrEmpty(t.SeatCode) ? t.SeatCode : (t.Seat != null ? $"{t.Seat.RowLabel}{t.Seat.SeatNumber}" : $"#{t.SeatId}")).OrderBy(x => x).ToList();

                <div class="rounded-3xl border border-[#E7E2D9] bg-white shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col justify-between">
                    
                    <!-- Card Top Header -->
                    <div class="px-5 py-3.5 bg-stone-50/70 border-b border-stone-200/80 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <i class="ph ph-hash text-stone-400"></i>
                            <span class="font-mono font-bold text-stone-900 text-sm tracking-wide">@b.BookingCode</span>
                        </div>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border text-xs font-bold @statusBg">
                            <i class="ph @statusIcon"></i>
                            <span>@statusText</span>
                        </span>
                    </div>

                    <!-- Card Body -->
                    <div class="p-5 flex-1">
                        <div class="flex items-start gap-4">
                            <!-- Movie Poster -->
                            @if (!string.IsNullOrEmpty(b.Showtime?.Movie?.PosterUrl))
                            {
                                <img src="@b.Showtime.Movie.PosterUrl" alt="@b.Showtime?.Movie?.Title"
                                     class="w-20 h-28 object-cover rounded-2xl flex-shrink-0 shadow-xs border border-stone-200" />
                            }
                            else
                            {
                                <div class="w-20 h-28 rounded-2xl bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-400 flex-shrink-0">
                                    <i class="ph ph-film-strip text-2xl"></i>
                                </div>
                            }

                            <!-- Details -->
                            <div class="flex-1 min-w-0">
                                <h3 class="text-base font-bold text-stone-900 leading-snug line-clamp-1 mb-1.5">
                                    @b.Showtime?.Movie?.Title
                                </h3>

                                <div class="space-y-1 text-xs text-stone-600">
                                    <div class="flex items-center gap-1.5">
                                        <i class="ph ph-clock text-emerald-600"></i>
                                        <span>@b.Showtime?.StartTime.ToVietnameseDateTimeString()</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <i class="ph ph-film-slate text-emerald-600"></i>
                                        <span>@b.Showtime?.Room?.RoomName</span>
                                    </div>
                                    <div class="flex items-center gap-1.5 pt-0.5">
                                        <i class="ph ph-armchair text-emerald-600"></i>
                                        <span>@seats.Count ghế: </span>
                                        <span class="font-bold text-stone-800">@(string.Join(", ", seats))</span>
                                    </div>
                                </div>

                                @if (b.BookingConcessions?.Any() == true)
                                {
                                    <div class="mt-2.5 text-[11px] text-stone-500 bg-stone-50 px-2 py-1 rounded-lg border border-stone-200/60 line-clamp-1">
                                        🍿 @string.Join(", ", b.BookingConcessions.Select(f => $"{(f.ItemName ?? f.FoodItem?.Name)} (×{f.Quantity})"))
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Perforation ticket notch line -->
                    <div class="relative flex items-center justify-between px-2 py-1">
                        <div class="w-4 h-4 rounded-full bg-[#FAF7F2] -ml-4 border border-[#E7E2D9]"></div>
                        <div class="flex-1 border-t-2 border-dashed border-stone-200 mx-2"></div>
                        <div class="w-4 h-4 rounded-full bg-[#FAF7F2] -mr-4 border border-[#E7E2D9]"></div>
                    </div>

                    <!-- Card Footer Actions -->
                    <div class="p-4 bg-stone-50/40 flex items-center justify-between gap-3">
                        <div>
                            <div class="text-[10px] uppercase font-bold text-stone-400">Tổng tiền</div>
                            <div class="text-lg font-black text-emerald-700">@b.FinalAmount.ToString("N0") đ</div>
                        </div>

                        <div class="flex items-center gap-2">
                            @if (b.Status == BookingStatus.Confirmed)
                            {
                                <a asp-action="Confirmation" asp-route-bookingId="@b.BookingId"
                                   class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition-all shadow-xs flex items-center gap-1.5">
                                    <i class="ph ph-qr-code text-sm"></i> Xem vé &amp; QR
                                </a>
                            }
                            else if (b.Status == BookingStatus.Pending)
                            {
                                <a asp-action="Checkout" asp-route-bookingId="@b.BookingId"
                                   class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs transition-all shadow-xs flex items-center gap-1.5">
                                    <i class="ph ph-credit-card text-sm"></i> Thanh toán ngay
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="MovieDetail" asp-route-id="@(b.Showtime?.MovieId ?? 1)"
                                   class="px-3.5 py-1.5 rounded-xl border border-stone-300 hover:bg-stone-100 text-stone-700 font-semibold text-xs transition-colors">
                                    Đặt lại vé
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
