@model IEnumerable<Booking>
@{
    ViewData["Title"] = "Lịch sử đặt vé";
    Layout = "_Layout";
}

<h4 class="fw-bold mb-4"><i class="bi bi-list-ul me-2 text-primary"></i>Lịch sử đặt vé của tôi</h4>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-ticket-perforated fs-1"></i>
        <p class="mt-3">Bạn chưa có lịch sử đặt vé nào.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-warning">
            <i class="bi bi-film me-1"></i>Xem phim đang chiếu
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var b in Model)
        {
            string statusBg = b.Status switch {
                BookingStatus.Confirmed => "bg-success",
                BookingStatus.Cancelled => "bg-secondary",
                BookingStatus.Expired   => "bg-danger",
                _                       => "bg-warning text-dark"
            };
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header d-flex justify-content-between align-items-center py-2 bg-dark text-white">
                        <small class="fw-bold" style="letter-spacing:.08em">@b.BookingCode</small>
                        <span class="badge @statusBg">
                            @switch (b.Status)
                            {
                                case BookingStatus.Confirmed: <text>Đã xác nhận</text> break;
                                case BookingStatus.Pending:   <text>Chờ thanh toán</text> break;
                                case BookingStatus.Cancelled: <text>Đã hủy</text> break;
                                default:                      <text>Hết hạn</text> break;
                            }
                        </span>
                    </div>
                    <div class="card-body p-3">
                        <div class="fw-bold mb-1">@b.Showtime?.Movie?.Title</div>
                        <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>@b.Showtime?.StartTime.ToString("HH:mm – dd/MM/yyyy")<br />
                            <i class="bi bi-building me-1"></i>@b.Showtime?.Room?.RoomName<br />
                            <i class="bi bi-grid-3x2 me-1"></i>@b.BookedSeats.Count ghế
                        </small>
                    </div>
                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center py-2 border-0">
                        <span class="fw-bold text-primary">@b.FinalAmount.ToString("N0") đ</span>
                        @if (b.Status == BookingStatus.Confirmed)
                        {
                            <a asp-action="Confirmation" asp-route-bookingId="@b.BookingId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Xem vé
                            </a>
                        }
                        else if (b.Status == BookingStatus.Pending)
                        {
                            <a asp-action="Checkout" asp-route-bookingId="@b.BookingId" class="btn btn-sm btn-warning">
                                <i class="bi bi-credit-card me-1"></i>Thanh toán
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
