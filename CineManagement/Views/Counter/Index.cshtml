@model dynamic
@{
    ViewData["Title"] = "Quầy Vé POS & Soát Vé QR";
    Layout = "_AdminLayout";
    var cinemas = ViewBag.Cinemas as List<CineManagement.Models.Cinema> ?? new();
    var availableFoodItems = ViewBag.AvailableFoodItems as List<CineManagement.Models.FoodItem> ?? new();
    var sampleBookings = ViewBag.SampleBookings as List<CineManagement.Models.Booking> ?? new();
    var staffName = ViewBag.StaffName as string ?? User.Identity?.Name ?? "Nhân viên quầy";
}

<div class="container-fluid px-0">
    <!-- Header Quầy POS -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                <i class="bi bi-shop text-success me-2"></i>Quầy Bán Vé POS &amp; Soát Đổi Vé QR
            </h4>
            <p class="text-muted small mb-0">Hệ thống một cửa: Đổi vé online &bull; Upsell Bắp Nước &bull; In vé nhiệt 80mm &bull; Bán vé tại quầy (Walk-in)</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold border border-success-subtle">
                <i class="bi bi-person-badge me-1"></i>Thu ngân: @staffName
            </span>
            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold border border-primary-subtle" id="signalrStatusBadge">
                <i class="bi bi-broadcast me-1"></i>SignalR: Sẵn sàng
            </span>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4 nav-fill p-1 bg-light rounded-4 shadow-sm" id="posTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold py-2.5 rounded-3" id="tab-redeem-tab" data-bs-toggle="pill" data-bs-target="#tab-redeem" type="button" role="tab">
                <i class="bi bi-qr-code-scan me-1.5 text-success"></i>1. Quét QR Đổi Vé Online &amp; Upsell F&amp;B &amp; In Vé
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold py-2.5 rounded-3" id="tab-walkin-tab" data-bs-toggle="pill" data-bs-target="#tab-walkin" type="button" role="tab">
                <i class="bi bi-ticket-perforated me-1.5 text-primary"></i>2. Bán Vé Trực Tiếp Tại Quầy (Walk-in POS)
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="posTabContent">

        <!-- ══════════════════════════════════════════════════════════════════════
             TAB 1: QUÉT QR ĐỔI VÉ + UPSELL F&B + IN VÉ NHIỆT 80MM
             ══════════════════════════════════════════════════════════════════════ -->
        <div class="tab-pane fade show active" id="tab-redeem" role="tabpanel">
            <div class="row g-4">
                <!-- Cột trái: Máy quét QR & Nhập mã -->
                <div class="col-12 col-xl-5">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
                        <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-camera-video text-success"></i>
                                <select id="cameraSelect" class="form-select form-select-sm bg-dark text-white border-secondary py-1" style="max-width: 170px; font-size: 0.8rem;">
                                    <option value="">Đang tìm camera...</option>
                                </select>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" id="btnToggleCam" class="btn btn-success btn-sm py-1 px-3 text-xs fw-semibold">
                                    <i class="bi bi-power me-1"></i>Bật Camera
                                </button>
                                <button type="button" onclick="document.getElementById('qrFileInput').click()" class="btn btn-outline-light btn-sm py-1 px-2.5 text-xs" title="Tải ảnh QR">
                                    <i class="bi bi-image me-1"></i>Tải ảnh
                                </button>
                                <input type="file" id="qrFileInput" accept="image/*" class="d-none" />
                            </div>
                        </div>

                        <!-- Khung Video QR Scanner -->
                        <div class="card-body p-0 text-center bg-black position-relative" style="min-height: 250px;">
                            <div id="reader" style="width: 100%; min-height: 250px; margin: 0 auto;"></div>
                            <div id="camIdleState" class="py-5 text-white-50">
                                <i class="bi bi-camera fs-1 mb-2 d-block opacity-50"></i>
                                <p class="small mb-2">Camera đang tạm tắt</p>
                                <div class="d-flex justify-content-center gap-2">
                                    <button type="button" onclick="startScanner()" class="btn btn-sm btn-success rounded-pill px-4 shadow">
                                        <i class="bi bi-camera-fill me-1"></i>Bật Camera quét mã
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Ô nhập mã vé / mã đơn thủ công -->
                        <div class="card-footer bg-white p-3 border-top">
                            <label class="form-label small fw-bold text-secondary mb-1">
                                <i class="bi bi-keyboard me-1"></i>Nhập mã đơn vé hoặc quét súng barcode:
                            </label>
                            <div class="input-group">
                                <input type="text" id="manualBookingCodeInput" class="form-control form-control-sm font-monospace text-uppercase" placeholder="Ví dụ: BK12345678 hoặc mã vé..." />
                                <button class="btn btn-primary btn-sm px-3 fw-bold" type="button" onclick="searchBookingCodeManual()">
                                    <i class="bi bi-search me-1"></i>Tra cứu
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Danh sách vé mẫu để Test nhanh (1-Click Test) -->
                    @if (sampleBookings.Any())
                    {
                        <div class="card border-0 shadow-sm rounded-3 bg-white">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small fw-bold text-uppercase">
                                        <i class="bi bi-lightning-charge text-warning me-1"></i>Mã đơn mẫu thử nghiệm nhanh:
                                    </span>
                                    <span class="badge bg-light text-muted border">Dữ liệu thực</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var sb in sampleBookings)
                                    {
                                        <button type="button" onclick="fetchBookingDetails('@sb.BookingCode')" 
                                                class="btn btn-sm btn-outline-secondary py-1 px-2.5 font-monospace text-xs text-dark hover-success">
                                            <i class="bi bi-ticket-perforated text-success me-1"></i>@sb.BookingCode 
                                            <span class="badge @(sb.Tickets.Any(t => t.IsPrinted) ? "bg-danger text-white" : "bg-success text-white") ms-1">
                                                @(sb.Tickets.Any(t => t.IsPrinted) ? "Đã in" : "Chưa in")
                                            </span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Cột phải: Chi tiết đơn hàng + Bảng Upsell F&B + Nút In vé nhiệt -->
                <div class="col-12 col-xl-7">
                    <!-- Trạng thái chờ -->
                    <div id="bookingPlaceholder" class="card border-dashed border-2 p-5 text-center text-muted bg-white rounded-4 shadow-sm">
                        <i class="bi bi-qr-code text-secondary opacity-50" style="font-size: 3.5rem;"></i>
                        <h5 class="fw-bold text-secondary mt-3 mb-1">Chưa có dữ liệu vé</h5>
                        <p class="small mb-0">Vui lòng quét mã QR từ điện thoại của khách hàng hoặc nhập mã đơn để tiến hành đổi vé &amp; in vé vật lý.</p>
                    </div>

                    <!-- Hộp Cảnh Báo Đỏ (Khi vé đã được in trước đó - Chống gian lận) -->
                    <div id="alreadyPrintedAlert" class="alert alert-danger border-2 border-danger rounded-4 p-4 shadow-sm d-none animate__animated animate__shakeX">
                        <div class="d-flex align-items-start gap-3">
                            <i class="bi bi-exclamation-triangle-fill fs-1 text-danger flex-shrink-0"></i>
                            <div>
                                <h5 class="fw-bold text-danger mb-1">⚠️ CẢNH BÁO ĐỎ: VÉ ĐÃ ĐƯỢC IN VẬT LÝ TRƯỚC ĐÓ!</h5>
                                <p class="mb-2 text-dark" id="alreadyPrintedMessage"></p>
                                <div class="badge bg-danger text-white px-3 py-1.5 fs-6">
                                    <i class="bi bi-shield-x me-1"></i>HỆ THỐNG TỪ CHỐI IN LẠI LẦN 2 ĐỂ PHÒNG NGỪA GIAN LẬN
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Chi tiết Đơn vé hợp lệ & Bảng Upsell F&B -->
                    <div id="bookingDetailsCard" class="card border-0 shadow-sm rounded-4 overflow-hidden d-none bg-white">
                        <div class="card-header bg-success text-white p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="badge bg-white text-success fw-bold px-2.5 py-1 me-2" id="detailBookingCode">BK000000</span>
                                <span class="fw-bold" id="detailCinemaName">CineStar Quốc Thanh</span>
                            </div>
                            <span class="badge bg-warning text-dark fw-bold px-3 py-1.5" id="detailPrintStatusBadge">Chưa in vé vật lý</span>
                        </div>

                        <div class="card-body p-4">
                            <!-- Thông tin Suất chiếu & Phim -->
                            <div class="row g-3 mb-3 pb-3 border-bottom">
                                <div class="col-md-7">
                                    <h5 class="fw-bold text-dark mb-1" id="detailMovieTitle">Tên Phim</h5>
                                    <div class="small text-muted mb-2">
                                        <span class="badge bg-secondary me-1" id="detailMovieFormat">2D</span>
                                        <span class="badge bg-info text-dark me-1" id="detailAgeRating">P</span>
                                        <span id="detailSubtitleType">Phụ đề Việt</span>
                                    </div>
                                    <div class="small text-dark">
                                        <i class="bi bi-clock text-success me-1"></i><strong id="detailStartTime">00:00 - 01/01/2026</strong> &bull; 
                                        <i class="bi bi-door-open text-primary ms-2 me-1"></i><strong id="detailRoomName">Phòng 01</strong>
                                    </div>
                                </div>
                                <div class="col-md-5 bg-light rounded-3 p-3">
                                    <div class="small text-muted mb-1">Khách hàng:</div>
                                    <div class="fw-bold text-dark text-truncate" id="detailCustomerName">Nguyễn Văn A</div>
                                    <div class="small text-secondary" id="detailCustomerPhone">0901234567</div>
                                    <div class="small text-secondary text-truncate" id="detailCustomerEmail">email@gmail.com</div>
                                </div>
                            </div>

                            <!-- Ghế ngồi & Combo đã đặt Online -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-dark small text-uppercase">
                                        <i class="bi bi-grid-3x3 me-1 text-primary"></i>Ghế ngồi đã đặt (<span id="detailTicketCount">0</span> vé):
                                    </span>
                                    <span class="fw-bold text-success" id="detailTicketAmount">0 đ</span>
                                </div>
                                <div class="d-flex flex-wrap gap-1.5 mb-3" id="detailSeatBadges">
                                    <!-- Badges rendered by JS -->
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-dark small text-uppercase">
                                        <i class="bi bi-cup-straw me-1 text-warning"></i>Bắp nước đã đặt trước (Online):
                                    </span>
                                    <span class="fw-bold text-warning" id="detailPreOrderedFnbAmount">0 đ</span>
                                </div>
                                <div id="detailPreOrderedFnbList" class="small text-muted mb-2">
                                    <!-- Pre-ordered F&B rendered by JS -->
                                </div>
                            </div>

                            <!-- ── MỜI KHÁCH MUA THÊM BẮP NƯỚC (UPSELL F&B TẠI QUẦY) ── -->
                            <div class="card border border-warning-subtle bg-warning-subtle/20 rounded-3 p-3 mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0">
                                        <i class="bi bi-cart-plus text-warning me-1.5 fs-5"></i>🍿 Mời khách mua thêm Combo Bắp Nước (Upsell tại quầy)
                                    </h6>
                                    <span class="badge bg-warning text-dark fw-bold">Thu tiền tại quầy</span>
                                </div>
                                <p class="small text-muted mb-3">Tư vấn khách nâng cấp combo lớn hoặc mua thêm nước/bắp tại quầy trước khi in vé.</p>

                                <div class="table-responsive">
                                    <table class="table table-sm table-borderless align-middle mb-0">
                                        <thead>
                                            <tr class="text-muted small border-bottom">
                                                <th>Món / Combo</th>
                                                <th class="text-end">Đơn giá</th>
                                                <th class="text-center" style="width: 140px;">Số lượng</th>
                                                <th class="text-end" style="width: 110px;">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody id="upsellFnbTableBody">
                                            <!-- Food items rendered by JS -->
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="small fw-bold text-dark">Hình thức thu tiền Upsell:</span>
                                        <select id="upsellPaymentMethod" class="form-select form-select-sm" style="width: 180px;">
                                            <option value="1">💵 Tiền mặt (Cash)</option>
                                            <option value="0">📲 VietQR Chuyển khoản</option>
                                        </select>
                                    </div>
                                    <div class="text-end">
                                        <span class="small text-muted">Cộng thêm F&amp;B:</span>
                                        <h5 class="fw-bold text-danger mb-0" id="upsellTotalAmount">+ 0 đ</h5>
                                    </div>
                                </div>
                            </div>

                            <!-- Tổng kết & Nút In vé nhiệt 80mm -->
                            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-4">
                                <div>
                                    <div class="small text-muted">Tổng giá trị đơn hàng sau Upsell:</div>
                                    <div class="fs-4 fw-bold text-dark" id="detailGrandTotal">0 đ</div>
                                </div>
                                <button type="button" class="btn btn-success btn-lg px-4 py-2.5 fw-bold shadow-sm rounded-3" id="btnConfirmAndPrint" onclick="submitConfirmPrintAndUpsell()">
                                    <i class="bi bi-printer-fill me-2 fs-5"></i>🖨️ Xác nhận &amp; In Vé Nhiệt (80mm)
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════════════════════════════
             TAB 2: BÁN VÉ TRỰC TIẾP TẠI QUẦY (WALK-IN POS)
             ══════════════════════════════════════════════════════════════════════ -->
        <div class="tab-pane fade" id="tab-walkin" role="tabpanel">
            <div class="row g-4">
                <!-- Cột trái: Chọn Rạp, Suất chiếu & Sơ đồ ghế 2D CSS Grid -->
                <div class="col-12 col-xl-8">
                    <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 bg-white">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-secondary mb-1">1. Chọn Cụm rạp:</label>
                                <select id="walkinCinemaSelect" class="form-select form-select-sm fw-semibold" onchange="loadShowtimesByCinema()">
                                    <option value="">-- Chọn Cụm Rạp --</option>
                                    @foreach (var c in cinemas)
                                    {
                                        <option value="@c.CinemaId">@c.Name (@c.City)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-bold text-secondary mb-1">2. Chọn Suất chiếu:</label>
                                <select id="walkinShowtimeSelect" class="form-select form-select-sm fw-semibold" disabled onchange="loadWalkInSeatMap()">
                                    <option value="">-- Vui lòng chọn Cụm rạp trước --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Màn hình Sơ đồ ghế 2D CSS Grid -->
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-dark text-white p-3 mb-3" style="min-height: 480px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="small text-white-50">
                                <i class="bi bi-info-circle me-1"></i>Sơ đồ ghế đồng bộ thời gian thực qua <strong>SignalR</strong>
                            </div>
                            <!-- Chú thích loại ghế -->
                            <div class="d-flex gap-3 small flex-wrap">
                                <span class="d-flex align-items-center gap-1.5"><span class="badge bg-secondary" style="width: 14px; height: 14px; padding: 0;"></span> Trống</span>
                                <span class="d-flex align-items-center gap-1.5"><span class="badge bg-success" style="width: 14px; height: 14px; padding: 0;"></span> Đang chọn</span>
                                <span class="d-flex align-items-center gap-1.5"><span class="badge bg-warning" style="width: 14px; height: 14px; padding: 0;"></span> Đang giữ</span>
                                <span class="d-flex align-items-center gap-1.5"><span class="badge bg-danger" style="width: 14px; height: 14px; padding: 0;"></span> Đã bán</span>
                            </div>
                        </div>

                        <!-- Màn hình cong phát sáng Screen -->
                        <div class="text-center my-2">
                            <div style="height: 8px; width: 65%; margin: 0 auto; background: linear-gradient(180deg, #10b981 0%, transparent 100%); border-radius: 50% 50% 0 0; box-shadow: 0 0 16px rgba(16,185,129,0.5);"></div>
                            <span class="text-xs text-white-50 fw-bold letter-spacing-2" style="font-size: 10px; letter-spacing: 3px;">MÀN HÌNH CHIẾU (SCREEN)</span>
                        </div>

                        <!-- Container Lưới ghế 2D Grid -->
                        <div id="walkinSeatGridContainer" class="d-flex justify-content-center align-items-center flex-grow-1 p-3 overflow-auto" style="min-height: 340px;">
                            <div class="text-center text-white-50 py-5">
                                <i class="bi bi-grid-3x3-gap fs-1 mb-2 d-block opacity-40"></i>
                                <p class="small">Vui lòng chọn Cụm rạp và Suất chiếu để tải sơ đồ ghế</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Chọn F&B + Thông tin khách + Thanh toán -->
                <div class="col-12 col-xl-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-3">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-person-lines-fill text-primary me-1.5"></i>Thông tin Khách quầy:
                        </h6>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Tên khách hàng:</label>
                            <input type="text" id="walkinCustomerName" class="form-control form-control-sm" value="Khách vãng lai" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1">Số điện thoại:</label>
                            <input type="text" id="walkinCustomerPhone" class="form-control form-control-sm" placeholder="090xxxxxxx" />
                        </div>

                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">
                            <i class="bi bi-cup-straw text-warning me-1.5"></i>Chọn Combo Bắp Nước:
                        </h6>
                        <div class="overflow-auto mb-3" style="max-height: 200px;">
                            <table class="table table-sm table-borderless align-middle mb-0">
                                <tbody>
                                    @foreach (var f in availableFoodItems)
                                    {
                                        <tr class="border-bottom">
                                            <td>
                                                <div class="fw-semibold small text-dark">@f.Name</div>
                                                <div class="text-muted" style="font-size: 11px;">@f.Price.ToString("N0") đ</div>
                                            </td>
                                            <td class="text-end" style="width: 110px;">
                                                <div class="input-group input-group-sm">
                                                    <button class="btn btn-outline-secondary py-0 px-2" type="button" onclick="changeWalkinFnbQty(@f.FoodItemId, -1, @f.Price)">-</button>
                                                    <input type="text" id="walkinFnbQty_@f.FoodItemId" class="form-control text-center py-0 px-1 fw-bold" value="0" readonly />
                                                    <button class="btn btn-outline-secondary py-0 px-2" type="button" onclick="changeWalkinFnbQty(@f.FoodItemId, 1, @f.Price)">+</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">
                            <i class="bi bi-cash-stack text-success me-1.5"></i>Thanh toán &amp; Xuất vé:
                        </h6>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Phương thức thanh toán:</label>
                            <select id="walkinPaymentMethod" class="form-select form-select-sm">
                                <option value="1">💵 Tiền mặt tại quầy (Cash)</option>
                                <option value="0">📲 VietQR Chuyển khoản</option>
                            </select>
                        </div>

                        <!-- Bảng tính tiền tổng -->
                        <div class="bg-light p-3 rounded-3 mb-3 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span>Tiền vé (<span id="walkinSeatCount">0</span> ghế):</span>
                                <span class="fw-bold" id="walkinTicketTotal">0 đ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>Tiền Bắp nước (F&amp;B):</span>
                                <span class="fw-bold" id="walkinFnbTotal">0 đ</span>
                            </div>
                            <div class="d-flex justify-content-between pt-2 border-top fs-6">
                                <span class="fw-bold text-dark">TỔNG CỘNG:</span>
                                <span class="fw-bold text-danger fs-5" id="walkinGrandTotal">0 đ</span>
                            </div>
                        </div>

                        <button type="button" class="btn btn-success w-100 py-2.5 fw-bold rounded-3 shadow-sm" id="btnSubmitWalkin" onclick="submitWalkinOrder()">
                            <i class="bi bi-printer-fill me-2"></i>Thanh Toán &amp; In Vé Ngay (80mm)
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<!-- Thư viện Quét mã QR html5-qrcode -->
<script src="~/lib/html5-qrcode/html5-qrcode.min.js"></script>
<!-- Thư viện SignalR Client -->
<script src="~/lib/signalr/signalr.min.js"></script>

<script>
    // ══════════════════════════════════════════════════════════════════════════
    // SIGNALR HUB CLIENT CONNECTION
    // ══════════════════════════════════════════════════════════════════════════
    let signalRConnection = null;
    let currentShowtimeIdForSignalR = 0;

    function initSignalR() {
        signalRConnection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/seatBooking")
            .withAutomaticReconnect([0, 2000, 5000, 10000])
            .build();

        signalRConnection.on("SeatStatusChanged", function (data) {
            console.log("[SignalR POS] Nhận sự kiện đổi trạng thái ghế:", data);
            // Cập nhật ghế trong sơ đồ Walk-in POS nếu đang mở cùng showtimeId
            if (currentShowtimeIdForSignalR === data.showtimeId) {
                updateWalkinSeatStatusRealtime(data.seatId, data.status, data.seatCode);
            }
        });

        signalRConnection.start()
            .then(() => {
                console.log("[SignalR POS] Kết nối SeatBookingHub thành công!");
                const badge = document.getElementById('signalrStatusBadge');
                if (badge) badge.className = "badge bg-success text-white px-3 py-2 rounded-pill fw-bold";
            })
            .catch(err => {
                console.error("[SignalR POS] Lỗi kết nối Hub:", err);
                const badge = document.getElementById('signalrStatusBadge');
                if (badge) {
                    badge.className = "badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold";
                    badge.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>SignalR: Ngắt kết nối';
                }
            });
    }

    function joinShowtimeSignalR(showtimeId) {
        if (!signalRConnection || signalRConnection.state !== signalR.HubConnectionState.Connected) return;
        if (currentShowtimeIdForSignalR > 0) {
            signalRConnection.invoke("LeaveShowtimeGroup", currentShowtimeIdForSignalR).catch(console.error);
        }
        currentShowtimeIdForSignalR = showtimeId;
        signalRConnection.invoke("JoinShowtimeGroup", showtimeId).catch(console.error);
    }

    // ══════════════════════════════════════════════════════════════════════════
    // TAB 1: LOGIC QUÉT QR, TRA CỨU ĐƠN, UPSELL F&B VÀ IN VÉ
    // ══════════════════════════════════════════════════════════════════════════
    let html5QrCode = null;
    let isCameraRunning = false;
    let currentBookingData = null;
    let currentUpsellItems = {}; // { foodItemId: qty }

    async function initCameraList() {
        try {
            const cameras = await Html5Qrcode.getCameras();
            const selectEl = document.getElementById('cameraSelect');
            selectEl.innerHTML = '';
            if (cameras && cameras.length > 0) {
                cameras.forEach((cam, idx) => {
                    const opt = document.createElement('option');
                    opt.value = cam.id;
                    opt.textContent = cam.label || `Camera ${idx + 1}`;
                    selectEl.appendChild(opt);
                });
            } else {
                selectEl.innerHTML = '<option value="">Không thấy camera</option>';
            }
        } catch (e) {
            console.warn('Lỗi lấy danh sách camera:', e);
        }
    }

    function toggleCamera() {
        if (isCameraRunning) {
            stopScanner();
        } else {
            startScanner();
        }
    }

    async function startScanner() {
        const selectEl = document.getElementById('cameraSelect');
        const cameraId = selectEl.value;
        if (!cameraId) {
            alert('Không tìm thấy camera khả dụng.');
            return;
        }

        document.getElementById('camIdleState').classList.add('d-none');
        html5QrCode = new Html5Qrcode("reader");

        const config = { fps: 10, qrbox: { width: 220, height: 220 } };
        try {
            await html5QrCode.start(
                cameraId,
                config,
                (decodedText) => {
                    console.log('Quét thành công:', decodedText);
                    stopScanner();
                    fetchBookingDetails(decodedText);
                },
                (errorMessage) => { /* ignore per-frame failures */ }
            );
            isCameraRunning = true;
            document.getElementById('btnToggleCam').innerHTML = '<i class="bi bi-stop-circle me-1"></i>Tắt Camera';
            document.getElementById('btnToggleCam').className = 'btn btn-danger btn-sm py-1 px-3 text-xs fw-semibold';
        } catch (err) {
            console.error('Lỗi khởi động camera:', err);
            alert('Không thể mở camera: ' + err);
            document.getElementById('camIdleState').classList.remove('d-none');
        }
    }

    async function stopScanner() {
        if (html5QrCode && isCameraRunning) {
            try {
                await html5QrCode.stop();
            } catch (e) { }
            isCameraRunning = false;
            document.getElementById('camIdleState').classList.remove('d-none');
            document.getElementById('btnToggleCam').innerHTML = '<i class="bi bi-power me-1"></i>Bật Camera';
            document.getElementById('btnToggleCam').className = 'btn btn-success btn-sm py-1 px-3 text-xs fw-semibold';
        }
    }

    // Quét từ file ảnh
    document.getElementById('qrFileInput').addEventListener('change', async function (e) {
        if (e.target.files.length === 0) return;
        const file = e.target.files[0];
        const scanner = new Html5Qrcode("reader");
        try {
            const decodedText = await scanner.scanFile(file, true);
            fetchBookingDetails(decodedText);
        } catch (err) {
            alert('Không tìm thấy mã QR hợp lệ trong ảnh: ' + err);
        }
    });

    document.getElementById('btnToggleCam').addEventListener('click', toggleCamera);

    function searchBookingCodeManual() {
        const code = document.getElementById('manualBookingCodeInput').value.trim();
        if (!code) {
            alert('Vui lòng nhập mã đơn hoặc mã vé!');
            return;
        }
        fetchBookingDetails(code);
    }

    async function fetchBookingDetails(code) {
        document.getElementById('bookingPlaceholder').classList.add('d-none');
        document.getElementById('alreadyPrintedAlert').classList.add('d-none');
        document.getElementById('bookingDetailsCard').classList.add('d-none');

        try {
            const resp = await fetch('/Counter/ScanBookingQr', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: code })
            });
            const data = await resp.json();

            if (!data.success) {
                // ĐÃ ĐƯỢC IN VÉ TRƯỚC ĐÓ -> BẬT CẢNH BÁO ĐỎ CHỐNG GIAN LẬN
                if (data.alreadyPrinted) {
                    document.getElementById('alreadyPrintedMessage').innerHTML = data.message;
                    document.getElementById('alreadyPrintedAlert').classList.remove('d-none');
                    return;
                }
                alert(data.message || 'Không tìm thấy thông tin đơn vé!');
                document.getElementById('bookingPlaceholder').classList.remove('d-none');
                return;
            }

            // Vé hợp lệ -> Hiển thị chi tiết
            renderBookingDetails(data);
        } catch (err) {
            console.error('Lỗi tra cứu đơn:', err);
            alert('Lỗi kết nối máy chủ!');
            document.getElementById('bookingPlaceholder').classList.remove('d-none');
        }
    }

    function renderBookingDetails(data) {
        currentBookingData = data;
        currentUpsellItems = {};

        document.getElementById('detailBookingCode').textContent = data.bookingCode;
        document.getElementById('detailCinemaName').textContent = data.cinemaName;
        document.getElementById('detailMovieTitle').textContent = data.movieTitle;
        document.getElementById('detailMovieFormat').textContent = data.movieFormat;
        document.getElementById('detailAgeRating').textContent = data.ageRating;
        document.getElementById('detailSubtitleType').textContent = data.subtitleType;
        document.getElementById('detailStartTime').textContent = data.startTime;
        document.getElementById('detailRoomName').textContent = data.roomName;

        document.getElementById('detailCustomerName').textContent = data.customerName;
        document.getElementById('detailCustomerPhone').textContent = data.customerPhone;
        document.getElementById('detailCustomerEmail').textContent = data.customerEmail;

        document.getElementById('detailTicketCount').textContent = data.ticketCount;
        document.getElementById('detailTicketAmount').textContent = Number(data.ticketAmount).toLocaleString('vi-VN') + ' đ';

        // Render Seat Badges
        const badgesContainer = document.getElementById('detailSeatBadges');
        badgesContainer.innerHTML = '';
        if (data.seatDetails) {
            data.seatDetails.forEach(s => {
                const b = document.createElement('span');
                b.className = 'badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 fw-bold';
                b.textContent = `${s.seatCode} (${s.seatType} - ${Number(s.price).toLocaleString('vi-VN')}đ)`;
                badgesContainer.appendChild(b);
            });
        }

        // Render Pre-ordered F&B
        const fnbList = document.getElementById('detailPreOrderedFnbList');
        const fnbAmountEl = document.getElementById('detailPreOrderedFnbAmount');
        fnbAmountEl.textContent = Number(data.fnbAmount).toLocaleString('vi-VN') + ' đ';
        if (data.preOrderedFnb && data.preOrderedFnb.length > 0) {
            fnbList.innerHTML = data.preOrderedFnb.map(f => 
                `<div>&bull; ${f.itemName} x <strong>${f.quantity}</strong> (${Number(f.subTotal).toLocaleString('vi-VN')} đ)</div>`
            ).join('');
        } else {
            fnbList.innerHTML = '<span class="text-stone-400 italic">Không có món đặt trước</span>';
        }

        // Render Upsell F&B Table
        renderUpsellTable(data.availableFoodItems);
        updateUpsellCalculation();

        document.getElementById('bookingDetailsCard').classList.remove('d-none');
    }

    function renderUpsellTable(items) {
        const tbody = document.getElementById('upsellFnbTableBody');
        tbody.innerHTML = '';
        if (!items || items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-2">Không có món F&B khả dụng</td></tr>';
            return;
        }

        items.forEach(item => {
            const tr = document.createElement('tr');
            tr.className = 'border-bottom';
            tr.innerHTML = `
                <td>
                    <div class="fw-semibold text-dark">${item.name}</div>
                    <div class="text-muted" style="font-size: 11px;">${item.description || 'Tiêu chuẩn'}</div>
                </td>
                <td class="text-end text-dark fw-semibold">${Number(item.price).toLocaleString('vi-VN')} đ</td>
                <td class="text-center">
                    <div class="input-group input-group-sm justify-content-center" style="width: 110px; margin: 0 auto;">
                        <button class="btn btn-outline-secondary py-0 px-2" type="button" onclick="changeUpsellQty(${item.foodItemId}, -1, ${item.price})">-</button>
                        <input type="text" id="upsellQty_${item.foodItemId}" class="form-control text-center py-0 px-1 fw-bold" value="0" readonly />
                        <button class="btn btn-outline-secondary py-0 px-2" type="button" onclick="changeUpsellQty(${item.foodItemId}, 1, ${item.price})">+</button>
                    </div>
                </td>
                <td class="text-end fw-bold text-danger" id="upsellLineTotal_${item.foodItemId}">0 đ</td>
            `;
            tbody.appendChild(tr);
        });
    }

    function changeUpsellQty(foodId, delta, price) {
        const current = currentUpsellItems[foodId] || 0;
        const next = Math.max(0, current + delta);
        currentUpsellItems[foodId] = next;

        const input = document.getElementById(`upsellQty_${foodId}`);
        const lineTotal = document.getElementById(`upsellLineTotal_${foodId}`);
        if (input) input.value = next;
        if (lineTotal) lineTotal.textContent = Number(next * price).toLocaleString('vi-VN') + ' đ';

        updateUpsellCalculation();
    }

    function updateUpsellCalculation() {
        if (!currentBookingData) return;
        let upsellTotal = 0;
        if (currentBookingData.availableFoodItems) {
            currentBookingData.availableFoodItems.forEach(item => {
                const qty = currentUpsellItems[item.foodItemId] || 0;
                upsellTotal += qty * item.price;
            });
        }

        document.getElementById('upsellTotalAmount').textContent = '+ ' + Number(upsellTotal).toLocaleString('vi-VN') + ' đ';
        const grandTotal = Number(currentBookingData.finalAmount) + upsellTotal;
        document.getElementById('detailGrandTotal').textContent = Number(grandTotal).toLocaleString('vi-VN') + ' đ';
    }

    async function submitConfirmPrintAndUpsell() {
        if (!currentBookingData) return;

        const upsellArray = [];
        for (const [foodId, qty] of Object.entries(currentUpsellItems)) {
            if (qty > 0) upsellArray.push({ foodItemId: parseInt(foodId), quantity: qty });
        }

        const paymentMethod = parseInt(document.getElementById('upsellPaymentMethod').value);

        const btn = document.getElementById('btnConfirmAndPrint');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý & in vé...';

        try {
            const resp = await fetch('/Counter/ConfirmPrintAndUpsell', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    bookingId: currentBookingData.bookingId,
                    upsellItems: upsellArray,
                    paymentMethod: paymentMethod
                })
            });
            const data = await resp.json();

            if (!data.success) {
                if (data.alreadyPrinted) {
                    alert(data.message);
                    location.reload();
                    return;
                }
                alert(data.message || 'Lỗi xác nhận in vé.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-printer-fill me-2 fs-5"></i>🖨️ Xác nhận & In Vé Nhiệt (80mm)';
                return;
            }

            // Thành công -> Bật popup In vé nhiệt 80mm
            window.open(data.printUrl, '_blank', 'width=420,height=680,scrollbars=yes');

            // Cập nhật giao diện
            document.getElementById('detailPrintStatusBadge').className = 'badge bg-danger text-white fw-bold px-3 py-1.5';
            document.getElementById('detailPrintStatusBadge').textContent = 'Đã in vé vật lý (' + data.thermalReceiptCode + ')';
            btn.className = 'btn btn-secondary btn-lg px-4 py-2.5 fw-bold shadow-sm rounded-3';
            btn.innerHTML = '✅ Đã Hoàn Tất In Vé Vật Lý';
            btn.disabled = true;

        } catch (err) {
            console.error('Lỗi xác nhận in vé:', err);
            alert('Lỗi gửi yêu cầu đến máy chủ!');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-printer-fill me-2 fs-5"></i>🖨️ Xác nhận & In Vé Nhiệt (80mm)';
        }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // TAB 2: LOGIC WALK-IN POS (BÁN VÉ TẠI QUẦY)
    // ══════════════════════════════════════════════════════════════════════════
    let walkinSelectedSeats = new Map(); // seatId -> { id, code, price, type }
    let walkinFnbQuantities = {};       // foodId -> qty
    let walkinFoodItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(availableFoodItems.Select(f => new { f.FoodItemId, f.Name, f.Price })));

    async function loadShowtimesByCinema() {
        const cinemaId = document.getElementById('walkinCinemaSelect').value;
        const showtimeSelect = document.getElementById('walkinShowtimeSelect');
        showtimeSelect.innerHTML = '<option value="">-- Đang tải suất chiếu... --</option>';
        showtimeSelect.disabled = true;
        walkinSelectedSeats.clear();
        updateWalkinSummary();

        if (!cinemaId) {
            showtimeSelect.innerHTML = '<option value="">-- Vui lòng chọn Cụm rạp trước --</option>';
            return;
        }

        try {
            const resp = await fetch(`/Counter/GetShowtimesByCinema?cinemaId=${cinemaId}`);
            const list = await resp.json();

            showtimeSelect.innerHTML = '<option value="">-- Chọn Suất Chiếu --</option>';
            if (list && list.length > 0) {
                list.forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s.showtimeId;
                    opt.textContent = `${s.movieTitle} (${s.movieFormat}) | ${s.roomName} | ${s.startTimeStr}`;
                    showtimeSelect.appendChild(opt);
                });
                showtimeSelect.disabled = false;
            } else {
                showtimeSelect.innerHTML = '<option value="">Không có suất chiếu nào hôm nay tại rạp này</option>';
            }
        } catch (err) {
            console.error('Lỗi tải suất chiếu:', err);
            showtimeSelect.innerHTML = '<option value="">Lỗi tải suất chiếu</option>';
        }
    }

    async function loadWalkInSeatMap() {
        const showtimeId = parseInt(document.getElementById('walkinShowtimeSelect').value);
        const container = document.getElementById('walkinSeatGridContainer');
        walkinSelectedSeats.clear();
        updateWalkinSummary();

        if (!showtimeId) {
            container.innerHTML = '<div class="text-center text-white-50 py-5"><p class="small">Vui lòng chọn Suất chiếu</p></div>';
            return;
        }

        // Tham gia nhóm SignalR của Suất chiếu này để nhận real-time seat lock
        joinShowtimeSignalR(showtimeId);

        container.innerHTML = '<div class="spinner-border text-success" role="status"><span class="visually-hidden">Loading...</span></div>';

        try {
            const resp = await fetch(`/Counter/GetShowtimeSeatMap?showtimeId=${showtimeId}`);
            const data = await resp.json();

            if (!data.success) {
                container.innerHTML = `<div class="text-danger py-4">${data.message || 'Lỗi tải sơ đồ ghế'}</div>`;
                return;
            }

            renderWalkInSeatGrid(data);
        } catch (err) {
            console.error('Lỗi tải sơ đồ ghế Walk-in:', err);
            container.innerHTML = '<div class="text-danger py-4">Lỗi kết nối máy chủ khi tải sơ đồ ghế</div>';
        }
    }

    function renderWalkInSeatGrid(data) {
        const container = document.getElementById('walkinSeatGridContainer');
        container.innerHTML = '';

        const grid = document.createElement('div');
        grid.style.display = 'grid';
        grid.style.gridTemplateRows = `repeat(${data.totalRows}, 32px)`;
        grid.style.gridTemplateColumns = `repeat(${data.totalCols}, 32px)`;
        grid.style.gap = '6px';
        grid.style.margin = '0 auto';

        data.seats.forEach(s => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.id = `walkin_seat_${s.seatId}`;
            btn.dataset.seatId = s.seatId;
            btn.dataset.seatCode = s.seatCode;
            btn.dataset.price = s.price;
            btn.dataset.seatType = s.seatTypeName;
            btn.dataset.status = s.status;
            btn.style.gridRow = s.gridRow;
            btn.style.gridColumn = `${s.gridCol} / span ${s.colSpan}`;
            btn.style.borderRadius = '5px';
            btn.style.border = '1px solid';
            btn.style.fontSize = '10px';
            btn.style.fontWeight = 'bold';
            btn.style.display = 'flex';
            btn.style.alignItems = 'center';
            btn.style.justifyContent = 'center';
            btn.style.cursor = 'pointer';
            btn.textContent = s.seatCode;

            applyWalkInSeatStyle(btn, s.status, s.seatTypeName, false);

            if (s.status === 0) { // Available
                btn.onclick = () => toggleWalkInSeat(btn, s);
            } else {
                btn.disabled = true;
            }

            grid.appendChild(btn);
        });

        container.appendChild(grid);
    }

    function applyWalkInSeatStyle(btn, status, seatType, isSelected) {
        if (isSelected) {
            btn.style.background = '#10b981';
            btn.style.borderColor = '#059669';
            btn.style.color = '#fff';
            btn.style.boxShadow = '0 0 8px rgba(16,185,129,0.8)';
            return;
        }

        if (status === 2) { // Reserved (Đã bán)
            btn.style.background = 'rgba(239, 68, 68, 0.25)';
            btn.style.borderColor = '#dc2626';
            btn.style.color = '#f87171';
            btn.style.cursor = 'not-allowed';
            btn.disabled = true;
        } else if (status === 1) { // Held (Đang giữ)
            btn.style.background = 'rgba(245, 158, 11, 0.25)';
            btn.style.borderColor = '#d97706';
            btn.style.color = '#fbbf24';
            btn.style.cursor = 'not-allowed';
            btn.disabled = true;
        } else { // Available
            btn.style.background = '#334155';
            btn.style.borderColor = seatType === 'VIP' ? '#d97706' : (seatType === 'Ghế đôi' ? '#9333ea' : '#64748b');
            btn.style.color = '#e2e8f0';
            btn.style.cursor = 'pointer';
            btn.disabled = false;
        }
    }

    function toggleWalkInSeat(btn, s) {
        if (walkinSelectedSeats.has(s.seatId)) {
            walkinSelectedSeats.delete(s.seatId);
            applyWalkInSeatStyle(btn, 0, s.seatTypeName, false);
        } else {
            walkinSelectedSeats.set(s.seatId, {
                id: s.seatId,
                code: s.seatCode,
                price: s.price,
                type: s.seatTypeName
            });
            applyWalkInSeatStyle(btn, 0, s.seatTypeName, true);
        }
        updateWalkinSummary();
    }

    function updateWalkinSeatStatusRealtime(seatId, status, seatCode) {
        const btn = document.getElementById(`walkin_seat_${seatId}`);
        if (!btn) return;

        // Nếu ghế này đang được thu ngân chọn nhưng khách online vừa mua mất
        if (status === 2 && walkinSelectedSeats.has(seatId)) {
            walkinSelectedSeats.delete(seatId);
            alert(`Ghế ${seatCode} vừa được thanh toán thành công bởi khách khác trên hệ thống!`);
            updateWalkinSummary();
        }

        btn.dataset.status = status;
        const seatType = btn.dataset.seatType;
        applyWalkInSeatStyle(btn, status, seatType, false);
    }

    function changeWalkinFnbQty(foodId, delta, price) {
        const cur = walkinFnbQuantities[foodId] || 0;
        const next = Math.max(0, cur + delta);
        walkinFnbQuantities[foodId] = next;

        const input = document.getElementById(`walkinFnbQty_${foodId}`);
        if (input) input.value = next;
        updateWalkinSummary();
    }

    function updateWalkinSummary() {
        const seatCount = walkinSelectedSeats.size;
        let ticketTotal = 0;
        walkinSelectedSeats.forEach(s => { ticketTotal += s.price; });

        let fnbTotal = 0;
        walkinFoodItems.forEach(item => {
            const q = walkinFnbQuantities[item.FoodItemId] || 0;
            fnbTotal += q * item.Price;
        });

        document.getElementById('walkinSeatCount').textContent = seatCount;
        document.getElementById('walkinTicketTotal').textContent = Number(ticketTotal).toLocaleString('vi-VN') + ' đ';
        document.getElementById('walkinFnbTotal').textContent = Number(fnbTotal).toLocaleString('vi-VN') + ' đ';
        document.getElementById('walkinGrandTotal').textContent = Number(ticketTotal + fnbTotal).toLocaleString('vi-VN') + ' đ';
    }

    async function submitWalkinOrder() {
        const showtimeId = parseInt(document.getElementById('walkinShowtimeSelect').value);
        if (!showtimeId) {
            alert('Vui lòng chọn Suất chiếu!');
            return;
        }

        if (walkinSelectedSeats.size === 0) {
            alert('Vui lòng chọn ít nhất 01 ghế ngồi trên sơ đồ!');
            return;
        }

        const selectedSeatIds = Array.from(walkinSelectedSeats.keys());
        const fnbItems = [];
        for (const [fid, qty] of Object.entries(walkinFnbQuantities)) {
            if (qty > 0) fnbItems.push({ foodItemId: parseInt(fid), quantity: qty });
        }

        const customerName = document.getElementById('walkinCustomerName').value.trim() || 'Khách vãng lai';
        const customerPhone = document.getElementById('walkinCustomerPhone').value.trim();
        const paymentMethod = parseInt(document.getElementById('walkinPaymentMethod').value);

        const btn = document.getElementById('btnSubmitWalkin');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xuất vé...';

        try {
            const resp = await fetch('/Counter/CreateWalkInOrder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    showtimeId: showtimeId,
                    selectedSeatIds: selectedSeatIds,
                    fnbItems: fnbItems,
                    customerName: customerName,
                    customerPhone: customerPhone,
                    paymentMethod: paymentMethod
                })
            });
            const data = await resp.json();

            if (!data.success) {
                alert(data.message || 'Lỗi tạo đơn vé Walk-in.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-printer-fill me-2"></i>Thanh Toán & In Vé Ngay (80mm)';
                return;
            }

            // Mở trang In vé nhiệt 80mm
            window.open(data.printUrl, '_blank', 'width=420,height=680,scrollbars=yes');

            // Reset và tải lại sơ đồ ghế
            alert(data.message);
            walkinSelectedSeats.clear();
            loadWalkInSeatMap();
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-printer-fill me-2"></i>Thanh Toán & In Vé Ngay (80mm)';

        } catch (err) {
            console.error('Lỗi tạo đơn Walk-in:', err);
            alert('Lỗi gửi yêu cầu đến máy chủ!');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-printer-fill me-2"></i>Thanh Toán & In Vé Ngay (80mm)';
        }
    }

    // Khởi chạy khi load trang
    window.addEventListener('DOMContentLoaded', () => {
        initCameraList();
        initSignalR();
    });
</script>
}