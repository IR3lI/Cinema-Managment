<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Admin Panel | CineManagement</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background:#f1f3f5; }
        .sidebar {
            width: 250px; min-height: 100vh;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            position: fixed; top:0; left:0; z-index: 100;
        }
        .sidebar .nav-link { color: #adb5bd; border-radius: 8px; margin: 2px 8px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background: rgba(255,255,255,0.1); color: #fff;
        }
        .sidebar .nav-link i { width: 22px; }
        .sidebar-brand { color:#ffc107; font-weight:700; font-size:1.1rem; padding:1rem 1.2rem; border-bottom:1px solid rgba(255,255,255,0.1); }
        .main-content { margin-left: 250px; min-height: 100vh; }
        .topbar { background:#fff; border-bottom:1px solid #dee2e6; padding:0.75rem 1.5rem; }
        .stat-card { border:none; border-radius:12px; }
        .table-container { background:#fff; border-radius:12px; padding:1.5rem; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar d-flex flex-column py-3">
        <div class="sidebar-brand">
            <i class="bi bi-camera-reels me-2"></i>CineManagement
        </div>
        <nav class="nav flex-column mt-3 flex-grow-1">
            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="nav-link text-uppercase fw-semibold text-secondary" style="font-size:.7rem;margin-top:.8rem;padding-left:1.3rem;">
                Lịch & Phòng chiếu
            </div>
            <a class="nav-link" asp-controller="ScreeningRoom" asp-action="Index">
                <i class="bi bi-building"></i> Phòng chiếu
            </a>
            <a class="nav-link" asp-controller="Showtime" asp-action="Index">
                <i class="bi bi-calendar-event"></i> Lịch chiếu
            </a>

            <div class="nav-link text-uppercase fw-semibold text-secondary" style="font-size:.7rem;margin-top:.8rem;padding-left:1.3rem;">
                Quản lý nội dung
            </div>
            <a class="nav-link" asp-controller="Movie" asp-action="Index">
                <i class="bi bi-film"></i> Danh mục Phim
            </a>
            <a class="nav-link" asp-controller="Genre" asp-action="Index">
                <i class="bi bi-tags"></i> Thể loại
            </a>
            <a class="nav-link" asp-controller="Food" asp-action="Index">
                <i class="bi bi-cup-straw"></i> Đồ ăn & Nước (F&B)
            </a>

            @if (User.IsInRole("Admin"))
            {
                <div class="nav-link text-uppercase fw-semibold text-secondary" style="font-size:.7rem;margin-top:.8rem;padding-left:1.3rem;">
                    Hệ thống
                </div>
                <a class="nav-link" asp-controller="Staff" asp-action="Index">
                    <i class="bi bi-people"></i> Nhân viên
                </a>
            }
            <div class="nav-link text-uppercase fw-semibold text-secondary" style="font-size:.7rem;margin-top:.8rem;padding-left:1.3rem;">
                Đặt vé
            </div>
            <a class="nav-link" asp-controller="Admin" asp-action="Bookings">
                <i class="bi bi-ticket-perforated"></i> Quản lý Đặt vé
            </a>
        </nav>
        <div class="mt-auto px-3 pb-3">
            <div class="d-flex align-items-center text-white mb-2">
                <i class="bi bi-person-circle me-2 fs-5"></i>
                <small class="text-truncate">@User.Identity?.Name</small>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                    <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                </button>
            </form>
        </div>
    </div>

    <!-- Main content -->
    <div class="main-content">
        <div class="topbar d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-semibold">@ViewData["Title"]</h6>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary me-2" target="_blank">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Xem Website
                </a>
                <a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-light">
                    <i class="bi bi-person me-1"></i>Hồ sơ
                </a>
            </div>
        </div>
        <div class="p-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
