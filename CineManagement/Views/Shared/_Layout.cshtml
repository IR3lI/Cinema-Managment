<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – CineStar Cinema</title>
    
    <!-- Tailwind CSS v4 Browser Setup -->
    <script src="https://unpkg.com/@@tailwindcss/browser@4"></script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>

    <!-- Inter Font with full Vietnamese support -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        body { 
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; 
            background-color: #FAF7F2; /* Cream white / warm ivory */
            color: #1C1917; /* Stone 900 */
        }
        
        /* Custom scrollbar for warm cream feel */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #FAF7F2; }
        ::-webkit-scrollbar-thumb { background: #D6CEBE; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #B5AB99; }

        /* Global Cream White Theme Harmonization */
        .bg-zinc-950 { background-color: #FAF7F2 !important; }
        .bg-zinc-900 { background-color: #FFFFFF !important; }
        .bg-zinc-800 { background-color: #F6F3EC !important; }
        .border-zinc-800, .border-zinc-700 { border-color: #E7E2D9 !important; }
        .text-zinc-100, .text-zinc-50 { color: #1C1917 !important; }
        .text-zinc-200, .text-zinc-300 { color: #292524 !important; }
        .text-zinc-400 { color: #57534E !important; }
        .text-zinc-500 { color: #78716C !important; }
        .text-zinc-600 { color: #A8A29E !important; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="antialiased min-h-[100dvh] flex flex-col selection:bg-emerald-200 selection:text-emerald-950">
    
    <!-- Navigation -->
    <header class="sticky top-0 z-50 w-full border-b border-[#E7E2D9] bg-white/95 backdrop-blur-md shadow-2xs">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-8">
            <!-- Brand -->
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5 group transition-transform hover:scale-[1.01]">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center shadow-xs">
                    <i class="ph-fill ph-film-slate text-xl"></i>
                </div>
                <span class="text-xl font-black tracking-tight text-stone-900">Cine<span class="text-emerald-600">Star</span></span>
            </a>

            <!-- Desktop Menu -->
            <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-stone-600">
                <a asp-controller="Home" asp-action="Index" class="hover:text-emerald-700 transition-colors flex items-center gap-1.5">
                    <i class="ph ph-film-reel text-base"></i> Phim đang chiếu
                </a>
                
                <div class="h-4 w-px bg-stone-300"></div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Counter" asp-action="Index" class="flex items-center gap-1.5 text-white bg-emerald-600 hover:bg-emerald-700 px-3 py-1.5 rounded-xl font-semibold text-xs transition-colors shadow-2xs">
                            <i class="ph ph-storefront text-base"></i> Quầy vé POS
                        </a>
                        <a asp-controller="Admin" asp-action="Dashboard" class="flex items-center gap-1.5 text-emerald-800 hover:text-emerald-900 bg-emerald-50 px-3 py-1.5 rounded-xl border border-emerald-200 transition-colors text-xs font-semibold">
                            <i class="ph ph-gauge text-base"></i> Quản trị
                        </a>
                    }
                    else if (User.IsInRole("Staff"))
                    {
                        <a asp-controller="Counter" asp-action="Index" class="flex items-center gap-1.5 text-white bg-emerald-600 hover:bg-emerald-700 px-3 py-1.5 rounded-xl font-semibold text-xs transition-colors shadow-2xs">
                            <i class="ph ph-storefront text-base"></i> Cổng Quầy Vé POS
                        </a>
                    }
                    <div class="group relative inline-block">
                        <button class="flex items-center gap-2 hover:text-stone-900 transition-colors py-2 cursor-pointer">
                            <div class="w-8 h-8 rounded-full bg-stone-200 text-stone-700 flex items-center justify-center font-bold text-xs">
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span class="max-w-[140px] truncate text-stone-800">@User.Identity.Name</span>
                            <i class="ph ph-caret-down text-xs text-stone-400"></i>
                        </button>
                        <!-- Dropdown Menu -->
                        <div class="absolute right-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 w-52 z-50">
                            <div class="rounded-2xl border border-[#E7E2D9] bg-white shadow-xl p-2 flex flex-col gap-1 text-sm text-stone-700">
                                <a asp-controller="Account" asp-action="Profile" class="flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-stone-100 text-stone-700 hover:text-stone-900 transition-colors">
                                    <i class="ph ph-user text-emerald-600"></i> Hồ sơ cá nhân
                                </a>
                                <a asp-controller="Booking" asp-action="MyBookings" class="flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-stone-100 text-stone-700 hover:text-stone-900 transition-colors">
                                    <i class="ph ph-ticket text-emerald-600"></i> Lịch sử đặt vé
                                </a>
                                <a asp-controller="Account" asp-action="ChangePassword" class="flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-stone-100 text-stone-700 hover:text-stone-900 transition-colors">
                                    <i class="ph ph-key text-emerald-600"></i> Đổi mật khẩu
                                </a>
                                <div class="h-px bg-stone-200 my-1"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="w-full">
                                    <button type="submit" class="flex w-full items-center gap-2 px-3 py-2 rounded-xl hover:bg-rose-50 text-rose-600 transition-colors text-left cursor-pointer">
                                        <i class="ph ph-sign-out"></i> Đăng xuất
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="hover:text-stone-900 transition-colors">Đăng nhập</a>
                    <a asp-controller="Account" asp-action="Register" class="rounded-xl bg-emerald-600 px-4 py-2 text-white hover:bg-emerald-700 hover:scale-[0.98] transition-all font-bold shadow-xs">Đăng ký</a>
                }
            </nav>

            <!-- Mobile Menu Toggle -->
            <button class="md:hidden p-2 text-stone-600 hover:text-stone-900">
                <i class="ph ph-list text-2xl"></i>
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow w-full max-w-7xl mx-auto px-6 lg:px-8 py-8 md:py-10">
        <!-- Toast Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 rounded-2xl border border-emerald-300 bg-emerald-50 p-4 text-emerald-900 flex items-center gap-3 shadow-2xs animate-in fade-in slide-in-from-top-4 duration-300">
                <i class="ph-fill ph-check-circle text-emerald-600 text-2xl flex-shrink-0"></i>
                <p class="text-sm font-semibold">@TempData["Success"]</p>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 rounded-2xl border border-rose-300 bg-rose-50 p-4 text-rose-900 flex items-center gap-3 shadow-2xs animate-in fade-in slide-in-from-top-4 duration-300">
                <i class="ph-fill ph-warning-circle text-rose-600 text-2xl flex-shrink-0"></i>
                <p class="text-sm font-semibold">@TempData["Error"]</p>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#E7E2D9] bg-[#F4EFE6] mt-auto">
        <div class="mx-auto max-w-7xl px-6 lg:px-8 py-10 md:py-12">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center text-sm shadow-2xs">
                        <i class="ph-fill ph-film-slate"></i>
                    </div>
                    <span class="font-bold text-stone-800 tracking-tight">CineStar Cinema</span>
                </div>
                <p class="text-xs text-stone-500 text-center md:text-left">
                    &copy; @DateTime.Now.Year. Hệ thống quản lý &amp; đặt vé xem phim trực tuyến thông minh.
                </p>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
