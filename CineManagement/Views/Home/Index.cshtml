@model MovieIndexViewModel
@{
    ViewData["Title"] = "Trang chủ – Phim đang chiếu";
    Layout = "_Layout";
}

<!-- Asymmetric Hero Section -->
<div class="relative w-full rounded-3xl overflow-hidden bg-stone-900 border border-stone-800 shadow-lg mb-10 lg:mb-12">
    <div class="absolute inset-0 bg-gradient-to-r from-stone-950 via-stone-900/90 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-2/3 opacity-30 mix-blend-screen bg-[url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=1200&auto=format&fit=crop')] bg-cover bg-center"></div>
    
    <div class="relative z-20 px-8 py-12 md:py-20 lg:px-14 flex flex-col justify-center max-w-2xl h-full">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-5 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-bold uppercase tracking-wider w-fit shadow-xs">
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            Rạp chiếu phim CineStar
        </div>
        <h1 class="text-3xl md:text-5xl lg:text-5xl font-black tracking-tight text-white leading-[1.15] mb-4">
            Đỉnh cao điện ảnh <br/><span class="text-emerald-400 font-black">trải nghiệm trọn vẹn.</span>
        </h1>
        <p class="text-stone-300 text-base md:text-lg leading-relaxed max-w-[45ch] mb-6 font-normal">
            Khám phá những siêu phẩm bom tấn đình đám nhất. Đặt vé trực tuyến nhanh chóng, thanh toán VietQR tiện lợi!
        </p>
        <div class="flex items-center gap-4">
            <a href="#movies-section" class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 text-stone-950 px-6 py-3 font-bold hover:bg-emerald-400 hover:scale-[0.98] transition-all shadow-md">
                <span>Xem lịch chiếu ngay</span>
                <i class="ph-bold ph-arrow-down"></i>
            </a>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div id="movies-section" class="mb-8 p-3 rounded-2xl bg-white border border-[#E7E2D9] shadow-sm relative z-20">
    <form method="get" asp-controller="Home" asp-action="Index" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
        <div class="md:col-span-5 relative group">
            <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-stone-400 group-focus-within:text-emerald-600 transition-colors">
                <i class="ph ph-magnifying-glass text-lg"></i>
            </div>
            <input type="text" name="search" value="@Model.SearchTerm" 
                   class="w-full bg-stone-50 border border-stone-200 rounded-xl pl-11 pr-4 py-2.5 text-sm text-stone-900 placeholder:text-stone-400 focus:outline-none focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-all font-medium" 
                   placeholder="Tìm phim theo tên, đạo diễn, diễn viên..." />
        </div>
        
        <div class="md:col-span-3 relative">
            <select name="genreId" class="w-full appearance-none bg-stone-50 border border-stone-200 rounded-xl px-4 py-2.5 text-sm text-stone-800 focus:outline-none focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-all font-medium">
                <option value="">– Tất cả thể loại –</option>
                @foreach (var g in Model.Genres)
                {
                    <option value="@g.Value" selected="@(g.Value == Model.GenreId?.ToString())">@g.Text</option>
                }
            </select>
            <div class="absolute inset-y-0 right-3.5 flex items-center pointer-events-none text-stone-400">
                <i class="ph-bold ph-caret-down"></i>
            </div>
        </div>
        
        <div class="md:col-span-2 relative">
            <select name="status" class="w-full appearance-none bg-stone-50 border border-stone-200 rounded-xl px-4 py-2.5 text-sm text-stone-800 focus:outline-none focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-all font-medium">
                <option value="">Đang &amp; Sắp chiếu</option>
                <option value="0" selected="@(Model.Status == MovieStatus.ComingSoon)">Sắp chiếu</option>
                <option value="1" selected="@(Model.Status == MovieStatus.NowShowing)">Đang chiếu</option>
                <option value="2" selected="@(Model.Status == MovieStatus.Ended)">Kết thúc</option>
            </select>
            <div class="absolute inset-y-0 right-3.5 flex items-center pointer-events-none text-stone-400">
                <i class="ph-bold ph-caret-down"></i>
            </div>
        </div>
        
        <div class="md:col-span-2">
            <button type="submit" class="w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl px-4 py-2.5 text-sm font-bold transition-all shadow-xs cursor-pointer">
                <i class="ph ph-funnel"></i>
                Lọc phim
            </button>
        </div>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.GenreId.HasValue || Model.Status.HasValue)
{
    <div class="mb-6 flex items-center gap-3">
        <span class="text-xs text-stone-500 font-semibold">Kết quả lọc:</span>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
            @Model.Movies.Count() phim
        </span>
        <a asp-action="Index" class="text-xs text-stone-500 hover:text-rose-600 transition-colors ml-2 flex items-center gap-1 font-semibold">
            <i class="ph ph-x"></i> Xóa bộ lọc
        </a>
    </div>
}

<!-- Movie Grid -->
@if (!Model.Movies.Any())
{
    <div class="py-20 text-center flex flex-col items-center justify-center border border-dashed border-[#E7E2D9] rounded-3xl bg-white p-8">
        <div class="w-16 h-16 mb-3 rounded-2xl bg-stone-100 flex items-center justify-center text-stone-400">
            <i class="ph ph-film-strip text-3xl"></i>
        </div>
        <h5 class="text-lg font-bold text-stone-800 mb-1">Không tìm thấy bộ phim phù hợp</h5>
        <p class="text-xs text-stone-500">Hãy thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc.</p>
    </div>
}
else
{
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5 lg:gap-6">
        @foreach (var movie in Model.Movies)
        {
            <div class="group rounded-2xl border border-[#E7E2D9] bg-white overflow-hidden shadow-xs hover:shadow-lg transition-all flex flex-col justify-between">
                <div>
                    <!-- Poster Container -->
                    <a asp-action="MovieDetail" asp-route-id="@movie.MovieId" class="block relative w-full aspect-[2/3] overflow-hidden bg-stone-100">
                        @if (!string.IsNullOrEmpty(movie.PosterUrl))
                        {
                            <img src="@movie.PosterUrl" alt="@movie.Title" 
                                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="absolute inset-0 flex items-center justify-center text-stone-300">
                                <i class="ph-fill ph-film-strip text-6xl"></i>
                            </div>
                        }
                        
                        <!-- Badges Overlay -->
                        <div class="absolute top-2.5 left-2.5 flex flex-col gap-1.5 z-10">
                            @switch (movie.Status)
                            {
                                case MovieStatus.NowShowing:
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-lg bg-emerald-600/95 text-white text-[11px] font-bold uppercase tracking-wider shadow-xs backdrop-blur-xs">
                                        Đang chiếu
                                    </span>
                                    break;
                                case MovieStatus.ComingSoon:
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-lg bg-amber-500/95 text-stone-950 text-[11px] font-bold uppercase tracking-wider shadow-xs backdrop-blur-xs">
                                        Sắp chiếu
                                    </span>
                                    break;
                                default:
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-lg bg-stone-700/90 text-white text-[11px] font-bold uppercase tracking-wider shadow-xs backdrop-blur-xs">
                                        Kết thúc
                                    </span>
                                    break;
                            }
                            
                            @if (!string.IsNullOrEmpty(movie.AgeRating))
                            {
                                <span class="inline-flex items-center justify-center w-fit px-2 py-0.5 rounded-lg bg-rose-600/95 text-white text-[10px] font-black shadow-xs">
                                    @movie.AgeRating
                                </span>
                            }
                        </div>
                    </a>
                    
                    <!-- Movie Details -->
                    <div class="p-4">
                        <div class="flex items-start justify-between gap-2 mb-1.5">
                            <h3 class="text-sm md:text-base font-bold text-stone-900 group-hover:text-emerald-700 transition-colors line-clamp-1">
                                <a asp-action="MovieDetail" asp-route-id="@movie.MovieId">
                                    @movie.Title
                                </a>
                            </h3>
                            @if (movie.Rating > 0)
                            {
                                <div class="flex items-center gap-1 text-amber-700 text-xs font-bold bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded-md flex-shrink-0">
                                    <i class="ph-fill ph-star text-amber-500"></i>
                                    <span>@movie.Rating</span>
                                </div>
                            }
                        </div>
                        <p class="text-xs text-stone-500 font-medium">
                            @movie.Duration phút • @(movie.Genre?.Name ?? "Phim chiếu rạp")
                        </p>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="p-4 pt-0">
                    <a asp-action="MovieDetail" asp-route-id="@movie.MovieId" 
                       class="w-full py-2 rounded-xl bg-stone-100 hover:bg-emerald-600 text-stone-800 hover:text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 shadow-2xs">
                        <i class="ph ph-ticket"></i> Mua vé
                    </a>
                </div>
            </div>
        }
    </div>
}
