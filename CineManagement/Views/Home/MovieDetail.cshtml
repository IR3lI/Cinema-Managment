@model Movie
@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<div class="row g-4">
    <div class="col-md-4 col-lg-3">
        @if (!string.IsNullOrEmpty(Model.PosterUrl))
        {
            <img src="@Model.PosterUrl" class="img-fluid rounded shadow" alt="@Model.Title" />
        }
        else
        {
            <div class="bg-secondary rounded d-flex align-items-center justify-content-center text-white" style="height:350px">
                <i class="bi bi-film fs-1"></i>
            </div>
        }
    </div>
    <div class="col-md-8 col-lg-9">
        <h2 class="fw-bold">@Model.Title</h2>
        <div class="mb-3">
            @switch (Model.Status)
            {
                case MovieStatus.NowShowing:
                    <span class="badge bg-success fs-6">Đang chiếu</span>
                    break;
                case MovieStatus.ComingSoon:
                    <span class="badge bg-warning text-dark fs-6">Sắp chiếu</span>
                    break;
                default:
                    <span class="badge bg-secondary fs-6">Kết thúc</span>
                    break;
            }
            @if (!string.IsNullOrEmpty(Model.AgeRating))
            {
                <span class="badge bg-danger ms-2">@Model.AgeRating</span>
            }
            @if (Model.Genre != null)
            {
                <span class="badge bg-info ms-2">@Model.Genre.Name</span>
            }
        </div>

        @if (Model.Rating > 0)
        {
            <div class="mb-3 text-warning fs-4">
                <i class="bi bi-star-fill"></i> @Model.Rating <small class="text-muted fs-6">/ 10</small>
            </div>
        }

        <table class="table table-borderless table-sm w-auto mb-3">
            <tr><th class="text-muted pe-4">Đạo diễn</th><td>@(Model.Director ?? "–")</td></tr>
            <tr><th class="text-muted pe-4">Diễn viên</th><td>@(Model.Actors ?? "–")</td></tr>
            <tr><th class="text-muted pe-4">Thời lượng</th><td>@Model.Duration phút</td></tr>
            <tr><th class="text-muted pe-4">Ngôn ngữ</th><td>@(Model.Language ?? "–")</td></tr>
            <tr><th class="text-muted pe-4">Khởi chiếu</th><td>@Model.ReleaseDate?.ToString("dd/MM/yyyy")</td></tr>
        </table>

        <p>@(Model.Description ?? "Chưa có mô tả.")</p>

        <div class="mt-3">
            @if (!string.IsNullOrEmpty(Model.TrailerUrl))
            {
                <a href="@Model.TrailerUrl" target="_blank" class="btn btn-danger me-2">
                    <i class="bi bi-play-fill me-1"></i>Xem trailer
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-dark">
                <i class="bi bi-arrow-left me-1"></i>Danh sách phim
            </a>
        </div>
    </div>
</div>
