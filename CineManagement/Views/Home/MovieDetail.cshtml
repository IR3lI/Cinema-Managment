@model Movie
@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
    var showtimesByDate = ViewBag.ShowtimesByDate as Dictionary<DateTime, List<Showtime>>
                         ?? new Dictionary<DateTime, List<Showtime>>();
    var dateKeys = showtimesByDate.Keys.OrderBy(d => d).ToList();
}

<div class="flex gap-8 flex-col md:flex-row">

    <!-- Poster -->
    <div class="flex-shrink-0 w-full md:w-56">
        @if (!string.IsNullOrEmpty(Model.PosterUrl))
        {
            <img src="@Model.PosterUrl" alt="@Model.Title"
                 class="w-full rounded-2xl shadow-2xl object-cover"
                 style="max-height:360px;object-fit:cover" />
        }
        else
        {
            <div class="w-full rounded-2xl bg-zinc-800 flex items-center justify-center text-zinc-600" style="height:360px">
                <i class="ph ph-film-strip text-5xl"></i>
            </div>
        }
    </div>

    <!-- Info -->
    <div class="flex-1 min-w-0">
        <!-- Badges -->
        <div class="flex flex-wrap gap-2 mb-3">
            @switch (Model.Status)
            {
                case MovieStatus.NowShowing:
                    <span class="px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-semibold">Đang chiếu</span>
                    break;
                case MovieStatus.ComingSoon:
                    <span class="px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-400 text-xs font-semibold">Sắp chiếu</span>
                    break;
                default:
                    <span class="px-3 py-1 rounded-full bg-zinc-700 text-zinc-400 text-xs font-semibold">Kết thúc</span>
                    break;
            }
            @if (!string.IsNullOrEmpty(Model.AgeRating))
            {
                <span class="px-3 py-1 rounded-full bg-red-500/15 border border-red-500/30 text-red-400 text-xs font-semibold">@Model.AgeRating</span>
            }
            @if (Model.Genre != null)
            {
                <span class="px-3 py-1 rounded-full bg-sky-500/15 border border-sky-500/30 text-sky-400 text-xs font-semibold">@Model.Genre.Name</span>
            }
        </div>

        <h1 class="text-3xl font-black text-zinc-100 mb-2">@Model.Title</h1>

        @if (Model.Rating > 0)
        {
            <div class="flex items-center gap-1.5 mb-4">
                <i class="ph-fill ph-star text-amber-400 text-lg"></i>
                <span class="text-amber-400 font-bold text-lg">@Model.Rating</span>
                <span class="text-zinc-500 text-sm">/ 10</span>
            </div>
        }

        <!-- Meta table -->
        <div class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm mb-5">
            @if (!string.IsNullOrEmpty(Model.Director))
            {
                <div class="text-zinc-500">Đạo diễn</div>
                <div class="text-zinc-200">@Model.Director</div>
            }
            @if (!string.IsNullOrEmpty(Model.Actors))
            {
                <div class="text-zinc-500">Diễn viên</div>
                <div class="text-zinc-200">@Model.Actors</div>
            }
            @if (Model.Duration > 0)
            {
                <div class="text-zinc-500">Thời lượng</div>
                <div class="text-zinc-200">@Model.Duration phút</div>
            }
            @if (!string.IsNullOrEmpty(Model.Language))
            {
                <div class="text-zinc-500">Ngôn ngữ</div>
                <div class="text-zinc-200">@Model.Language</div>
            }
            @if (Model.ReleaseDate.HasValue)
            {
                <div class="text-zinc-500">Khởi chiếu</div>
                <div class="text-zinc-200">@Model.ReleaseDate.Value.ToString("dd/MM/yyyy")</div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-zinc-400 text-sm leading-relaxed mb-5">@Model.Description</p>
        }

        <div class="flex gap-3 flex-wrap">
            @if (!string.IsNullOrEmpty(Model.TrailerUrl))
            {
                <a href="@Model.TrailerUrl" target="_blank"
                   class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white text-sm font-semibold transition-colors flex items-center gap-2">
                    <i class="ph ph-play-circle"></i> Xem trailer
                </a>
            }
            <a asp-action="Index"
               class="px-5 py-2.5 rounded-xl border border-zinc-700 hover:border-zinc-600 text-zinc-400 hover:text-zinc-200 text-sm font-medium transition-colors flex items-center gap-2">
                <i class="ph ph-arrow-left"></i> Danh sách phim
            </a>
        </div>
    </div>
</div>

<!-- ── Lịch chiếu ─────────────────────────────────────────────────── -->
<div class="mt-10">
    <div class="flex items-center gap-3 mb-6">
        <i class="ph ph-calendar-check text-emerald-400 text-2xl"></i>
        <h3 class="text-xl font-bold text-zinc-100">Lịch chiếu phim</h3>
    </div>

    @if (!showtimesByDate.Any())
    {
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-12 text-center">
            <i class="ph ph-calendar-x text-5xl text-zinc-700 block mb-3"></i>
            <p class="text-zinc-500">Hiện tại chưa có suất chiếu nào sắp tới cho phim này.</p>
        </div>
    }
    else
    {
        <!-- Date tabs -->
        <div class="flex gap-2 mb-6 overflow-x-auto pb-1 flex-wrap">
            @for (int i = 0; i < dateKeys.Count; i++)
            {
                var d = dateKeys[i];
                bool isToday = d.Date == DateTime.Today;
                string dayName = isToday ? "Hôm nay" : d.ToString("dddd");
                <button type="button"
                        class="date-tab flex-shrink-0 flex flex-col items-center px-5 py-2.5 rounded-xl border text-sm font-medium transition-all
                               @(i == 0 ? "bg-emerald-500 border-emerald-500 text-white" : "border-zinc-800 text-zinc-400 hover:border-zinc-700 hover:text-zinc-200")"
                        data-target="day-@d.ToString("yyyyMMdd")">
                    <span class="text-xs opacity-75">@dayName</span>
                    <span class="font-bold">@d.ToString("dd/MM")</span>
                </button>
            }
        </div>

        <!-- Showtime panels -->
        @for (int i = 0; i < dateKeys.Count; i++)
        {
            var d = dateKeys[i];
            var slots = showtimesByDate[d];
            <div class="day-panel @(i == 0 ? "" : "hidden")" id="day-@d.ToString("yyyyMMdd")">
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
                    @foreach (var st in slots)
                    {
                        string roomBadgeCls = st.Room?.RoomType switch {
                            RoomType.VIP  => "bg-amber-500/15 border-amber-500/30 text-amber-400",
                            RoomType.IMAX => "bg-purple-500/15 border-purple-500/30 text-purple-400",
                            _             => "bg-zinc-700/50 border-zinc-700 text-zinc-400"
                        };

                        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-4 flex flex-col gap-2 hover:border-zinc-700 transition-colors">
                            <!-- Time -->
                            <div class="text-2xl font-black text-zinc-100 text-center">
                                @st.StartTime.ToString("HH:mm")
                            </div>
                            @if (st.EndTime.HasValue)
                            {
                                <div class="text-xs text-zinc-500 text-center">→ @st.EndTime.Value.ToString("HH:mm")</div>
                            }

                            <!-- Room badge -->
                            <div class="text-center">
                                <span class="px-2 py-0.5 rounded-full border text-xs font-medium @roomBadgeCls">
                                    @st.Room?.RoomName
                                </span>
                            </div>

                            <!-- Price -->
                            <div class="text-center text-emerald-400 font-bold text-sm">
                                @st.TicketPrice.ToString("N0") đ
                            </div>

                            <!-- Book button -->
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-controller="Booking" asp-action="SelectSeat"
                                   asp-route-showtimeId="@st.ShowtimeId"
                                   class="mt-auto w-full py-2 rounded-xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-400
                                          hover:bg-emerald-500 hover:text-white text-xs font-semibold text-center transition-all">
                                    Chọn suất này
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login"
                                   asp-route-returnUrl="@Url.Action("MovieDetail","Home",new{id=Model.MovieId})"
                                   class="mt-auto w-full py-2 rounded-xl border border-zinc-700 text-zinc-500
                                          hover:border-zinc-600 hover:text-zinc-300 text-xs font-medium text-center transition-all flex items-center justify-center gap-1">
                                    <i class="ph ph-lock"></i> Đăng nhập để đặt
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
<script>
    // Date tab switching
    document.querySelectorAll('.date-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            // Update tab styles
            document.querySelectorAll('.date-tab').forEach(t => {
                t.className = t.className
                    .replace('bg-emerald-500 border-emerald-500 text-white', '')
                    + ' border-zinc-800 text-zinc-400 hover:border-zinc-700 hover:text-zinc-200';
            });
            tab.className = tab.className
                .replace('border-zinc-800 text-zinc-400 hover:border-zinc-700 hover:text-zinc-200', '')
                + ' bg-emerald-500 border-emerald-500 text-white';

            // Show/hide panels
            document.querySelectorAll('.day-panel').forEach(p => p.classList.add('hidden'));
            document.getElementById(tab.dataset.target)?.classList.remove('hidden');
        });
    });
</script>
}
