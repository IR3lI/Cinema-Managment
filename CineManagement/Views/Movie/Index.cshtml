@model MovieIndexViewModel
@{
    ViewData["Title"] = "Danh mục Phim";
    Layout = "_AdminLayout";
}

<div class="table-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-film me-2"></i>Danh mục Phim</h5>
        <a asp-action="Create" class="btn btn-warning">
            <i class="bi bi-plus-lg me-1"></i>Thêm phim mới
        </a>
    </div>

    <!-- Filter -->
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Tìm theo tên phim, đạo diễn..." />
        </div>
        <div class="col-md-3">
            <select name="genreId" class="form-select">
                <option value="">– Tất cả thể loại –</option>
                @foreach (var g in Model.Genres)
                {
                    <option value="@g.Value" selected="@(g.Value == Model.GenreId?.ToString())">@g.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">– Tất cả trạng thái –</option>
                <option value="0" selected="@(Model.Status == MovieStatus.ComingSoon)">Sắp chiếu</option>
                <option value="1" selected="@(Model.Status == MovieStatus.NowShowing)">Đang chiếu</option>
                <option value="2" selected="@(Model.Status == MovieStatus.Ended)">Kết thúc</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search me-1"></i>Tìm
            </button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th width="60">Poster</th>
                    <th>Tên phim</th>
                    <th>Thể loại</th>
                    <th>Thời lượng</th>
                    <th>Trạng thái</th>
                    <th>Đánh giá</th>
                    <th width="140">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in Model.Movies)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl" width="45" height="60" style="object-fit:cover;border-radius:4px;" alt="Poster" />
                            }
                            else
                            {
                                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="width:45px;height:60px;">
                                    <i class="bi bi-film text-white"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@movie.Title</div>
                            <small class="text-muted">@movie.Director</small>
                        </td>
                        <td><span class="badge bg-secondary">@(movie.Genre?.Name ?? "–")</span></td>
                        <td>@movie.Duration phút</td>
                        <td>
                            @switch (movie.Status)
                            {
                                case MovieStatus.NowShowing:
                                    <span class="badge bg-success">Đang chiếu</span>
                                    break;
                                case MovieStatus.ComingSoon:
                                    <span class="badge bg-warning text-dark">Sắp chiếu</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Kết thúc</span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (movie.Rating > 0)
                            {
                                <span class="text-warning"><i class="bi bi-star-fill"></i> @movie.Rating</span>
                            }
                            else { <span class="text-muted">–</span> }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@movie.MovieId" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-sm btn-outline-primary" title="Sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <form asp-action="Delete" asp-route-id="@movie.MovieId" method="post" class="d-inline"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa phim này?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Movies.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-film fs-2"></i>
                <p>Không tìm thấy phim nào.</p>
            </div>
        }
    </div>
</div>
