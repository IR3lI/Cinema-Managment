@model IEnumerable<Genre>
@{
    ViewData["Title"] = "Quản lý Thể loại";
    Layout = "_AdminLayout";
}

<div class="table-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-tags me-2"></i>Thể loại phim</h5>
        <a asp-action="Create" class="btn btn-warning">
            <i class="bi bi-plus-lg me-1"></i>Thêm thể loại
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tên thể loại</th>
                    <th>Mô tả</th>
                    <th>Số phim</th>
                    <th width="120">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td class="fw-semibold">@g.Name</td>
                        <td class="text-muted">@(g.Description ?? "–")</td>
                        <td><span class="badge bg-primary">@g.Movies.Count</span></td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@g.GenreId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@g.GenreId" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa thể loại này?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


