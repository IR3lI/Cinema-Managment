@model IEnumerable<Movie>
@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "_AdminLayout";
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card stat-card bg-primary text-white shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <i class="bi bi-film fs-2 opacity-75"></i>
                <div class="fs-3 fw-bold mt-1">@ViewBag.TotalMovies</div>
                <div class="small opacity-75">Tổng phim</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card stat-card bg-success text-white shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <i class="bi bi-play-circle fs-2 opacity-75"></i>
                <div class="fs-3 fw-bold mt-1">@ViewBag.NowShowing</div>
                <div class="small opacity-75">Đang chiếu</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card stat-card bg-dark text-white shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <i class="bi bi-building fs-2 text-warning opacity-75"></i>
                <div class="fs-3 fw-bold mt-1">@ViewBag.TotalRooms</div>
                <div class="small opacity-75">Phòng chiếu</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card stat-card bg-warning text-dark shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <i class="bi bi-calendar-event fs-2 opacity-75"></i>
                <div class="fs-3 fw-bold mt-1">@ViewBag.TotalShowtimes</div>
                <div class="small opacity-75">Suất chiếu tới</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card stat-card text-white shadow-sm h-100" style="background:#6f42c1;">
            <div class="card-body p-3 text-center">
                <i class="bi bi-ticket-perforated fs-2 opacity-75"></i>
                <div class="fs-3 fw-bold mt-1">@ViewBag.TodayBookings</div>
                <div class="small opacity-75">Đặt vé hôm nay</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card stat-card bg-danger text-white shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <i class="bi bi-cash-stack fs-2 opacity-75"></i>
                <div class="fs-3 fw-bold mt-1" style="font-size:1.2rem!important">@(((decimal)ViewBag.TodayRevenue).ToString("N0"))đ</div>
                <div class="small opacity-75">Doanh thu hôm nay</div>
            </div>
        </div>
    </div>
</div>

<div class="table-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-film me-2"></i>Phim mới thêm gần đây</h5>
        <div class="d-flex gap-2">
            <a asp-controller="Showtime" asp-action="Create" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-calendar-plus me-1"></i>Lên lịch chiếu
            </a>
            <a asp-controller="Movie" asp-action="Create" class="btn btn-warning btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Thêm phim
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tên phim</th>
                    <th>Thể loại</th>
                    <th>Trạng thái</th>
                    <th>Đánh giá</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@movie.Title</div>
                            <small class="text-muted">@movie.Director</small>
                        </td>
                        <td><span class="badge bg-secondary">@(movie.Genre?.Name ?? "–")</span></td>
                        <td>
                            @switch (movie.Status)
                            {
                                case MovieStatus.NowShowing:
                                    <span class="badge bg-success">Đang chiếu</span>
                                    break;
                                case MovieStatus.ComingSoon:
                                    <span class="badge bg-warning text-dark">Sắp chiếu</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Kết thúc</span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (movie.Rating > 0)
                            {
                                <span class="text-warning"><i class="bi bi-star-fill"></i> @movie.Rating</span>
                            }
                            else { <span class="text-muted">–</span> }
                        </td>
                        <td>
                            <a asp-controller="Movie" asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <p class="text-muted text-center py-3">Chưa có phim nào.</p>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <a asp-controller="Movie" asp-action="Index" class="btn btn-outline-primary btn-sm">
            Xem tất cả phim <i class="bi bi-arrow-right ms-1"></i>
        </a>
        <a asp-controller="Admin" asp-action="Bookings" class="btn btn-outline-secondary btn-sm">
            Xem đặt vé hôm nay <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</div>
