@model IEnumerable<Booking>
@{
    ViewData["Title"] = "Quản lý Đặt vé";
    Layout = "_AdminLayout";
    var currentStatus = ViewBag.Status as BookingStatus?;
}

<div class="table-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-ticket-perforated me-2"></i>Danh sách Đặt vé</h5>
        <div class="text-muted small">Tổng: <strong>@Model.Count()</strong> đơn</div>
    </div>

    <!-- Filter -->
    <form method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <input type="text" name="search" class="form-control" placeholder="Mã đặt vé hoặc email..." value="@ViewBag.Search" />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">– Tất cả trạng thái –</option>
                <option value="0" selected="@(currentStatus == BookingStatus.Pending)">Chờ thanh toán</option>
                <option value="1" selected="@(currentStatus == BookingStatus.Confirmed)">Đã xác nhận</option>
                <option value="2" selected="@(currentStatus == BookingStatus.Cancelled)">Đã hủy</option>
                <option value="3" selected="@(currentStatus == BookingStatus.Expired)">Hết hạn</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="date" name="date" class="form-control" value="@(((DateTime?)ViewBag.Date)?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Tìm kiếm</button>
        </div>
    </form>
    @if (currentStatus.HasValue || ViewBag.Date != null || ViewBag.Search != null)
    {
        <a asp-action="Bookings" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-x me-1"></i>Xóa bộ lọc</a>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã đặt vé</th>
                    <th>Khách hàng</th>
                    <th>Phim</th>
                    <th>Suất chiếu</th>
                    <th>Ghế</th>
                    <th>Thành tiền</th>
                    <th>Trạng thái</th>
                    <th>Thời gian</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td><span class="badge bg-dark fw-bold" style="letter-spacing:.08em">@b.BookingCode</span></td>
                        <td>
                            <small class="text-muted">@b.User?.Email</small>
                        </td>
                        <td class="fw-semibold">@b.Showtime?.Movie?.Title</td>
                        <td>
                            <div>@b.Showtime?.StartTime.ToString("HH:mm")</div>
                            <small class="text-muted">@b.Showtime?.StartTime.ToString("dd/MM/yyyy")</small><br />
                            <small class="text-muted">@b.Showtime?.Room?.RoomName</small>
                        </td>
                        <td><span class="badge bg-primary">@b.BookedSeats.Count ghế</span></td>
                        <td class="fw-bold text-success">@b.FinalAmount.ToString("N0") đ</td>
                        <td>
                            @switch (b.Status)
                            {
                                case BookingStatus.Confirmed: <span class="badge bg-success">Đã xác nhận</span> break;
                                case BookingStatus.Pending:   <span class="badge bg-warning text-dark">Chờ TT</span> break;
                                case BookingStatus.Cancelled: <span class="badge bg-secondary">Đã hủy</span> break;
                                default:                      <span class="badge bg-danger">Hết hạn</span> break;
                            }
                        </td>
                        <td><small class="text-muted">@b.BookingTime.ToString("HH:mm dd/MM")</small></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-ticket-perforated fs-1"></i>
                <p class="mt-2">Không tìm thấy đơn đặt vé nào.</p>
            </div>
        }
    </div>
</div>
