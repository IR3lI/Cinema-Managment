@model CineManagement.Models.Cinema
@{
    ViewData["Title"] = "Thêm Cụm Rạp Mới";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-plus-circle text-success me-2"></i>Thêm Cụm Rạp Mới
                </h5>
                <a asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại
                </a>
            </div>

            <form asp-action="Create" method="post" class="card-body p-4">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Code" class="form-label fw-bold text-dark small"></label>
                        <input asp-for="Code" class="form-control font-monospace text-uppercase" placeholder="VD: CS-QT" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-bold text-dark small"></label>
                        <input asp-for="Name" class="form-control" placeholder="VD: CineStar Quốc Thanh" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Address" class="form-label fw-bold text-dark small"></label>
                        <input asp-for="Address" class="form-control" placeholder="VD: 271 Nguyễn Trãi, Phường Nguyễn Cư Trinh" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label fw-bold text-dark small"></label>
                        <input asp-for="City" class="form-control" placeholder="VD: TP. Hồ Chí Minh" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Hotline" class="form-label fw-bold text-dark small"></label>
                        <input asp-for="Hotline" class="form-control" placeholder="VD: 1900 6017" />
                        <span asp-validation-for="Hotline" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold text-dark small"></label>
                        <input asp-for="Email" class="form-control" placeholder="VD: csqt@cinestar.com.vn" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label fw-bold text-dark small"></label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="URL hình ảnh cụm rạp..." />
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold text-dark small"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả cụm rạp..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                    <label asp-for="IsActive" class="form-check-label fw-bold text-dark small"></label>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                    <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                        <i class="bi bi-check-circle me-1.5"></i>Lưu Cụm Rạp
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>