<?xml version="1.0" ?>
<mxfile host="app.diagrams.net" modified="2026-10-29T04:05:00.000Z" agent="Antigravity Architecture Generator" version="21.6.8" type="device">
  <diagram id="CineManagement-Arch" name="CineManagement Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&amp;lt;b style=&amp;quot;font-size: 20px;&amp;quot;&amp;gt;CINEMANAGEMENT - SYSTEM ARCHITECTURE &amp;amp; COMPONENT FLOW&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;span style=&amp;quot;color: #64748B;&amp;quot;&amp;gt;5-Tier Architecture: Client -&gt; ASP.NET Core 10 Web App -&gt; SignalR / Outbox Worker -&gt; MariaDB (cinema_db)&amp;lt;/span&amp;gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="900" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="tier1_box" value="&amp;lt;b&amp;gt;TIER 1: CLIENT PRESENTATION LAYER&amp;lt;/b&amp;gt;" style="swimlane;fontStyle=1;align=left;spacingLeft=15;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="300" height="650" as="geometry"/>
        </mxCell>
        <mxCell id="client_customer" value="&amp;lt;b style=&amp;quot;font-size: 14px; color: #0284C7;&amp;quot;&amp;gt;Customer Web Portal&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;• Razor Pages + Bootstrap 5&amp;lt;br&amp;gt;• 2D CSS Grid Seat Map Matrix&amp;lt;br&amp;gt;• SignalR JavaScript WebSockets&amp;lt;br&amp;gt;• QR Code E-Ticket Viewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1.5;align=left;spacingLeft=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="260" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="client_staff" value="&amp;lt;b style=&amp;quot;font-size: 14px; color: #16A34A;&amp;quot;&amp;gt;Staff Box Office POS Console&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;• Quầy vé &amp;amp; FnB Upsell (/Counter)&amp;lt;br&amp;gt;• html5-qrcode Camera Scanner&amp;lt;br&amp;gt;• Máy in nhiệt K80 (80mm Thermal)&amp;lt;br&amp;gt;• Chống in vé lậu (Anti-Reprint Guard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;align=left;spacingLeft=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="260" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="client_admin" value="&amp;lt;b style=&amp;quot;font-size: 14px; color: #D97706;&amp;quot;&amp;gt;Admin Management Studio&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;• Visual Seat Layout Builder Studio&amp;lt;br&amp;gt;• Cấu hình ma trận hàng/cột &amp;amp; hành lang&amp;lt;br&amp;gt;• Điều phối phim, suất chiếu, phòng&amp;lt;br&amp;gt;• Báo cáo doanh thu &amp;amp; Audit Logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=left;spacingLeft=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="530" width="260" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="tier2_box" value="&amp;lt;b&amp;gt;TIER 2 &amp;amp; 3: ASP.NET CORE 10 WEB APPLICATION &amp;amp; BACKGROUND WORKERS&amp;lt;/b&amp;gt;" style="swimlane;fontStyle=1;align=left;spacingLeft=15;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="620" height="650" as="geometry"/>
        </mxCell>
        <mxCell id="controllers_box" value="&amp;lt;b style=&amp;quot;font-size: 13px; color: #4338CA;&amp;quot;&amp;gt;Presentation &amp;amp; API Controllers&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;• BookingController (/Booking/SelectSeat, /Checkout)&amp;lt;br&amp;gt;• CounterController (/Counter/Index, /PrintThermalTicket)&amp;lt;br&amp;gt;• ScreeningRoomController (/ScreeningRoom/LayoutBuilder)&amp;lt;br&amp;gt;• AccountController (ASP.NET Core Identity RBAC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="450" y="150" width="580" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="services_box" value="&amp;lt;b style=&amp;quot;font-size: 13px; color: #059669;&amp;quot;&amp;gt;Business Logic &amp;amp; Concurrency Control Engine&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;BookingService&amp;lt;/b&amp;gt;: HoldSeatAsync, ReleaseSeatAsync (IsolationLevel.Serializable)&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;PaymentService&amp;lt;/b&amp;gt;: ConfirmPaymentAsync, Outbox Message Event Emission&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;Dual-Concurrency Engine&amp;lt;/b&amp;gt;: Pessimistic DB Locks + Optimistic Version Check (ss.Version++)&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;SeatLayoutStudio&amp;lt;/b&amp;gt;: Matrix calculation, Sweetbox ColSpan=2 Aisle Guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="450" y="280" width="580" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="signalr_box" value="&amp;lt;b style=&amp;quot;font-size: 13px; color: #7C3AED;&amp;quot;&amp;gt;SignalR Real-Time WebSockets Hub&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;SeatBookingHub (/hubs/seat)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• Grouping theo ShowtimeId: Clients.Group(showtime_id)&amp;lt;br&amp;gt;• Real-time Broadcast: &amp;lt;i&amp;gt;SeatStatusChanged&amp;lt;/i&amp;gt; (&amp;lt; 50ms latency)&amp;lt;br&amp;gt;• Đồng bộ tức thì Available / Held / Reserved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="450" y="430" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="workers_box" value="&amp;lt;b style=&amp;quot;font-size: 13px; color: #B45309;&amp;quot;&amp;gt;Hosted Background Services&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;OutboxMessageWorker&amp;lt;/b&amp;gt;:&amp;lt;br&amp;gt;  - Polling bảng outboxmessages mỗi 5s&amp;lt;br&amp;gt;  - Gửi Email vé điện tử qua SMTP Gmail&amp;lt;br&amp;gt;  - Zero Email Loss Guarantee&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;SeatHoldTimeoutWorker&amp;lt;/b&amp;gt;:&amp;lt;br&amp;gt;  - Giải phóng ghế giữ tạm quá 5 phút&amp;lt;br&amp;gt;  - Kích hoạt SignalR broadcast ghế trống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="750" y="430" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="dbcontext_box" value="&amp;lt;b style=&amp;quot;font-size: 13px; color: #1E293B;&amp;quot;&amp;gt;Data Access Layer: ApplicationDbContext (EF Core 10)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Pomelo MySQL Provider • Connection Pooling • ACID Transactions • IdentityDbContext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="450" y="610" width="580" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t4_box" value="&amp;lt;b&amp;gt;TIER 4: DATABASE &amp;amp; MESSAGING PERSISTENCE&amp;lt;/b&amp;gt;" style="swimlane;fontStyle=1;align=left;spacingLeft=15;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0EA5E9;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="100" width="380" height="650" as="geometry"/>
        </mxCell>
        <mxCell id="mariadb_box" value="&amp;lt;b style=&amp;quot;font-size: 15px; color: #0369A1;&amp;quot;&amp;gt;MariaDB 10.11 InnoDB Server&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;span style=&amp;quot;color: #64748B;&amp;quot;&amp;gt;Port 3306 • Database: cinema_db&amp;lt;/span&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;Core Schema Tables (3NF):&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;cinemas&amp;lt;/b&amp;gt; (3 cụm rạp: CS-QT, CS-HBT, CS-BD)&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;screeningrooms&amp;lt;/b&amp;gt; (Grid ma trận hàng &amp;amp; cột)&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;seattypes&amp;lt;/b&amp;gt; (Standard, VIP, Couple Sweetbox)&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;seats&amp;lt;/b&amp;gt; (GridRow, GridCol, ColSpan, RowLabel)&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;showtimes&amp;lt;/b&amp;gt; (210 suất chiếu đã seed)&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;showtimeseats&amp;lt;/b&amp;gt; (&amp;lt;b style=&amp;quot;color:#0284C7;&amp;quot;&amp;gt;31,806 bản ghi&amp;lt;/b&amp;gt;, Version concurrency)&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;bookings&amp;lt;/b&amp;gt; &amp;amp; &amp;lt;b&amp;gt;bookingconcessions&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;tickets&amp;lt;/b&amp;gt; (IsPrinted thermal flag, QrPayload)&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;outboxmessages&amp;lt;/b&amp;gt; (Transactional Outbox events)&amp;lt;br&amp;gt;• &amp;lt;b&amp;gt;payments&amp;lt;/b&amp;gt; &amp;amp; &amp;lt;b&amp;gt;aspnetusers&amp;lt;/b&amp;gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;align=left;spacingLeft=25;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1165" y="150" width="330" height="390" as="geometry"/>
        </mxCell>
        <mxCell id="smtp_box" value="&amp;lt;b style=&amp;quot;font-size: 13px; color: #EA4335;&amp;quot;&amp;gt;Google SMTP Mail Server&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;smtp.gmail.com:587 (TLS/SSL)&amp;lt;br&amp;gt;Nhận dispatch từ OutboxWorker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="1165" y="570" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="edge_c1" value="HTTP POST / Hold / Pay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;" edge="1" source="client_customer" target="controllers_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_c2" value="POS QR / In vé K80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;" edge="1" source="client_staff" target="controllers_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_c3" value="Save Layout Studio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;" edge="1" source="client_admin" target="controllers_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_ws" value="WebSockets Real-time Broadcast" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;dashed=1;strokeColor=#7C3AED;strokeWidth=2;" edge="1" source="signalr_box" target="client_customer" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_ws2" value="WebSockets Real-time" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;dashed=1;strokeColor=#7C3AED;" edge="1" source="signalr_box" target="client_staff" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_c_s" value="Call Business Services" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;" edge="1" source="controllers_box" target="services_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_s_hub" value="Trigger State Change" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;strokeColor=#7C3AED;" edge="1" source="services_box" target="signalr_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_s_db" value="Transaction (Serializable)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;strokeColor=#059669;strokeWidth=2;" edge="1" source="services_box" target="dbcontext_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_db_maria" value="SQL Queries &amp; Commits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;strokeColor=#0284C7;strokeWidth=2;" edge="1" source="dbcontext_box" target="mariadb_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_w_maria" value="Poll outboxmessages (5s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;strokeColor=#B45309;dashed=1;" edge="1" source="workers_box" target="mariadb_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_w_smtp" value="Send E-Ticket Mail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;strokeColor=#EA4335;strokeWidth=2;" edge="1" source="workers_box" target="smtp_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_w_hub" value="Timeout Seat Release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;strokeColor=#F59E0B;dashed=1;" edge="1" source="workers_box" target="signalr_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
